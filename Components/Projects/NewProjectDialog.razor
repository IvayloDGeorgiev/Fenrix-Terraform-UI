@using Fenrix.IaCStudio.Application.Abstractions.Projects
@using Fenrix.IaCStudio.Application.Settings
@using Fenrix.IaCStudio.Contracts.Projects
@inject IProjectService Projects
@inject IProjectTemplateService Templates
@inject IFolderPicker FolderPicker

<Modal Title="New project" IconName="folder-plus" Wide="true" OnClose="Cancel">
    <ChildContent>
    <div class="fx-field">
        <label>Project name</label>
        <input class="fx-input" @bind="_name" @bind:event="oninput" placeholder="Customer Infrastructure" />
    </div>

    <div class="fx-field">
        <label>Location</label>
        <div style="display:flex;gap:8px;">
            <input class="fx-input" @bind="_parentDirectory" placeholder="Default: Fenrix projects folder" />
            @if (FolderPicker.IsSupported)
            {
                <button class="fx-btn" @onclick="BrowseAsync" type="button">Browse…</button>
            }
        </div>
        <div class="fx-hint">The project folder is created inside this location. Leave blank to use the Fenrix projects folder.</div>
    </div>

    <div class="fx-field">
        <label>Description <span style="color:var(--fx-faint);">(optional)</span></label>
        <textarea class="fx-textarea" @bind="_description" placeholder="What this infrastructure is for."></textarea>
    </div>

    <div class="fx-field">
        <label>Start from</label>
        <div class="fx-hint" style="margin-bottom:8px;">Pick a template to prefill every environment with a complete, cost-aware starter — or start blank.</div>
        <div class="fx-tmpl-filter">
            <button type="button" class="fx-fchip @(_providerFilter is null ? "active" : "")" @onclick="() => _providerFilter = null">All</button>
            @foreach (var p in _providers)
            {
                <button type="button" class="fx-fchip @(_providerFilter == p ? "active" : "")" @onclick="() => _providerFilter = p">@ProviderLabel(p)</button>
            }
        </div>
        <div class="fx-tmpl-grid">
            <button type="button" class="fx-tmpl-card @(_templateId is null ? "sel" : "")" @onclick="() => _templateId = null">
                <div class="fx-tmpl-head"><Icon Name="file" Size="14" /> <span class="fx-tmpl-name">Blank project</span></div>
                <div class="fx-tmpl-desc">Empty starter — just the recommended structure and placeholder files.</div>
            </button>
            @foreach (var t in FilteredTemplates)
            {
                <button type="button" class="fx-tmpl-card @(_templateId == t.Id ? "sel" : "")" @onclick="() => _templateId = t.Id" title="@t.Description">
                    <div class="fx-tmpl-head">
                        <span class="fx-tag">@ProviderLabel(t.Provider)</span>
                        <span class="fx-tmpl-name">@t.Name</span>
                        <span class="fx-tag @CostClass(t.CostTier)">@CostLabel(t.CostTier)</span>
                    </div>
                    <div class="fx-tmpl-desc">@t.Description</div>
                    <div class="fx-tmpl-cost">@t.CostSummary</div>
                </button>
            }
        </div>
    </div>


    <div class="fx-field">
        <label>Environments</label>
        <div class="fx-hint" style="margin-bottom:6px;">
            Select a cloud connection for each environment — Fenrix uses it to authenticate Terraform for that
            environment. You can leave it unset and bind later (the environment is flagged until you do).
        </div>
        @foreach (var env in _environments)
        {
            <div class="fx-env-row">
                <input class="fx-input" @bind="env.Name" />
                <label style="display:flex;align-items:center;gap:6px;font-size:12px;color:var(--fx-dim);white-space:nowrap;">
                    <input type="checkbox" @bind="env.IsProduction" /> Production
                </label>
                <button class="fx-iconbtn" title="Remove" @onclick="() => RemoveEnv(env)"><Icon Name="trash" Size="15" /></button>
            </div>
            <div style="margin:2px 0 10px 0;">
                <CloudConnectionPicker @bind-SelectedId="env.CloudConnectionId" />
            </div>
        }
        <button class="fx-btn sm" type="button" @onclick="AddEnv"><span class="fx-ico"><Icon Name="plus" Size="13" /></span> Add environment</button>

        <div style="display:flex;gap:8px;align-items:center;margin-top:10px;">
            <span style="font-size:12px;color:var(--fx-dim);white-space:nowrap;">Apply one to all:</span>
            <CloudConnectionPicker @bind-SelectedId="_applyAllId" />
            <button class="fx-btn sm" type="button" @onclick="ApplyToAll" disabled="@(_applyAllId is null)">Apply</button>
        </div>
    </div>

    <div class="fx-field" style="display:flex;gap:18px;">
        <label style="display:flex;align-items:center;gap:7px;font-size:13px;">
            <input type="checkbox" @bind="_initGit" /> Add .gitignore
        </label>
        <label style="display:flex;align-items:center;gap:7px;font-size:13px;">
            <input type="checkbox" @bind="_writeManifest" /> Write .fenrix/project-manifest.json
        </label>
    </div>

    @if (_error is not null)
    {
        <div class="fx-error">@_error</div>
    }
    </ChildContent>

    <Footer>
        <button class="fx-btn ghost" @onclick="Cancel" disabled="@_busy">Cancel</button>
        <button class="fx-btn accent" @onclick="CreateAsync" disabled="@_busy">
            @(_busy ? "Creating…" : "Create project")
        </button>
    </Footer>
</Modal>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<Guid> OnCreated { get; set; }

    private string _name = "";
    private string? _parentDirectory;
    private string? _description;
    private bool _initGit = true;
    private bool _writeManifest = true;
    private bool _busy;
    private string? _error;

    private readonly List<NewEnvironmentSpec> _environments = CreateProjectRequest.DefaultEnvironments();
    private Guid? _applyAllId;

    private IReadOnlyList<ProjectTemplateInfo> _templates = [];
    private string? _templateId;
    private TemplateProvider? _providerFilter;
    private TemplateProvider[] _providers = [];

    protected override void OnInitialized()
    {
        _templates = Templates.List();
        _providers = _templates.Select(t => t.Provider).Distinct().OrderBy(p => p).ToArray();
    }

    private IEnumerable<ProjectTemplateInfo> FilteredTemplates =>
        _providerFilter is null ? _templates : _templates.Where(t => t.Provider == _providerFilter);

    private static string ProviderLabel(TemplateProvider p) => p switch
    {
        TemplateProvider.Aws => "AWS",
        TemplateProvider.Azure => "Azure",
        TemplateProvider.Gcp => "GCP",
        TemplateProvider.Docker => "Docker",
        TemplateProvider.MultiCloud => "Multi",
        _ => "Other"
    };

    private static string CostLabel(TemplateCostTier t) => t switch
    {
        TemplateCostTier.Free => "Free / demo",
        TemplateCostTier.Low => "Low cost",
        _ => "Medium"
    };

    private static string CostClass(TemplateCostTier t) => t switch
    {
        TemplateCostTier.Free => "free",
        TemplateCostTier.Low => "",
        _ => "warn"
    };

    private void AddEnv() => _environments.Add(new NewEnvironmentSpec { Name = "New" });
    private void RemoveEnv(NewEnvironmentSpec env) => _environments.Remove(env);

    private void ApplyToAll()
    {
        foreach (var env in _environments)
            env.CloudConnectionId = _applyAllId;
    }

    private async Task BrowseAsync()
    {
        var picked = await FolderPicker.PickFolderAsync();
        if (!string.IsNullOrEmpty(picked))
            _parentDirectory = picked;
    }

    private Task Cancel() => OnClose.InvokeAsync();

    private async Task CreateAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_name))
        {
            _error = "Please enter a project name.";
            return;
        }
        if (_environments.Count == 0 || _environments.Any(e => string.IsNullOrWhiteSpace(e.Name)))
        {
            _error = "Every environment needs a name (or remove the empty ones).";
            return;
        }

        _busy = true;
        try
        {
            var request = new CreateProjectRequest
            {
                Name = _name.Trim(),
                ParentDirectory = string.IsNullOrWhiteSpace(_parentDirectory) ? null : _parentDirectory!.Trim(),
                Description = string.IsNullOrWhiteSpace(_description) ? null : _description,
                InitializeGit = _initGit,
                WriteManifest = _writeManifest,
                Environments = _environments,
                TemplateId = _templateId
            };

            var project = await Projects.CreateAsync(request);
            await OnCreated.InvokeAsync(project.Id);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _busy = false;
        }
    }
}
