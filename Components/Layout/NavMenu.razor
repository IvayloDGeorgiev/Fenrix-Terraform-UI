@* Global left navigation rail. See docs/13-ui-design.md. *@
@using Fenrix.IaCStudio.Application.Abstractions.Enterprise
@inject IEnterpriseConfig Enterprise

<nav class="fx-rail">
    <div class="fx-brand">
        <span class="fx-logo"><Icon Name="hexagon" Size="20" /></span>
        Fenrix
    </div>

    <NavLink class="fx-nav" href="/" Match="NavLinkMatch.All">
        <span class="fx-ico"><Icon Name="dashboard" /></span> Dashboard
    </NavLink>
    <NavLink class="fx-nav" href="projects">
        <span class="fx-ico"><Icon Name="folder" /></span> Projects
    </NavLink>
    <NavLink class="fx-nav" href="source-control">
        <span class="fx-ico"><Icon Name="git-branch" /></span> Source control
    </NavLink>
    <NavLink class="fx-nav" href="connections">
        <span class="fx-ico"><Icon Name="plug" /></span> Connections
    </NavLink>
    <NavLink class="fx-nav" href="activity">
        <span class="fx-ico"><Icon Name="activity" /></span> Activity
    </NavLink>
    <NavLink class="fx-nav" href="templates">
        <span class="fx-ico"><Icon Name="template" /></span> Templates
    </NavLink>

    @if (Enterprise.IsEnabled)
    {
        <div style="font-size:10.5px;text-transform:uppercase;letter-spacing:.08em;color:var(--fx-faint);padding:14px 16px 4px;">Enterprise</div>
        <NavLink class="fx-nav" href="enterprise/admin">
            <span class="fx-ico"><Icon Name="shield" /></span> Administration
        </NavLink>
        <NavLink class="fx-nav" href="enterprise/approvals">
            <span class="fx-ico"><Icon Name="inbox" /></span> Approvals
        </NavLink>
        <NavLink class="fx-nav" href="enterprise/audit">
            <span class="fx-ico"><Icon Name="list" /></span> Audit log
        </NavLink>
    }

    <div class="fx-nav-spacer"></div>

    <NavLink class="fx-nav" href="help">
        <span class="fx-ico"><Icon Name="help" /></span> Help
    </NavLink>
    <NavLink class="fx-nav" href="settings">
        <span class="fx-ico"><Icon Name="settings" /></span> Settings
    </NavLink>
</nav>
