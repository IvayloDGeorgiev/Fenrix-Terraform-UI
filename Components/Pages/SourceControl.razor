    private Task UpdateSubmodulesAsync() =>
        RunRemoteTagAsync(p => Git.UpdateSubmodulesAsync(_projectId, init: true, recursive: true, p), "Submodules updated.");

    private Task SyncSubmodulesAsync() => MutateAsync(() => Git.SyncSubmodulesAsync(_projectId), reloadSubmodules: true);

    private static string SubmoduleClass(GitSubmoduleState s) => s switch
    {
        GitSubmoduleState.InSync => "add",
        GitSubmoduleState.Uninitialised => "muted",
        GitSubmoduleState.Conflicted => "fail",
        _ => "warn"
    };

    private static string SubmoduleGlyph(GitSubmoduleState s) => s switch
    {
        GitSubmoduleState.InSync => "✓",
        GitSubmoduleState.Uninitialised => "-",
        GitSubmoduleState.Conflicted => "U",
        _ => "+"
    };

    private static string SubmoduleLabel(GitSubmoduleState s) => s switch
    {
        GitSubmoduleState.InSync => "in sync",
        GitSubmoduleState.Uninitialised => "not initialised",
        GitSubmoduleState.Conflicted => "conflicts",
        _ => "out of sync"
    };

    // ---- Phase 6: partial / line staging ----

    private void ToggleLine((int Hunk, int Line) key)
    {
        if (!_selectedLines.Add(key)) _selectedLines.Remove(key);
        StateHasChanged();
    }

    private async Task ApplySelectedLinesAsync()
    {
        if (_diffFile is null || _selectedLines.Count == 0) return;
        _busy = true; _error = null; _notice = null;
        try
        {
            var r = await Git.ApplySelectedLinesAsync(_projectId, _diffFile, new HashSet<(int, int)>(_selectedLines), unstage: _diffIsStaged);
            if (!r.Succeeded) { _error = r.Error ?? "Could not apply the selected lines."; return; }
            _notice = _diffIsStaged ? "Unstaged the selected lines." : "Staged the selected lines.";
            _selectedLines.Clear();
            await RefreshAfterMutationAsync();
            // Reload the current file diff so the remaining changes are shown.
            var files = await Git.GetDiffAsync(_projectId, new GitDiffSpec(_diffIsStaged ? GitDiffSource.Staged : GitDiffSource.WorkTree, Path: _diffFile.Path));
            _diffFile = files.FirstOrDefault();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    // ---- Phase 6: interactive rebase ----

    private async Task OpenRebaseAsync()
    {
        _busy = true; _error = null;
        try
        {
            var count = Math.Clamp(_rebaseCount, 1, 50);
            var commits = await Git.GetRebaseCommitsAsync(_projectId, count);
            if (commits.Count == 0) { _error = "No commits to rebase."; return; }
            _rebaseSteps = commits.Select(c => new GitRebaseStep(c.Sha, c.ShortSha, c.Subject, RebaseAction.Pick)).ToList();
            _rebaseBase = $"HEAD~{commits.Count}";
            UpdateRebasePreview();
            _showRebase = true;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private void UpdateRebasePreview() =>
        _rebasePreview = Preview(GitCommandCatalog.RebaseInteractive(_rebaseBase, autosquash: false));

    private async Task StartRebaseAsync(GitRebasePlan plan)
    {
        _showRebase = false;
        _busy = true; _error = null; _notice = null; _output.Clear();
        var progress = new Progress<ProcessOutputEvent>(OnLine);
        try
        {
            var r = await Git.StartInteractiveRebaseAsync(_projectId, plan, progress);
            _sequencer = await Git.GetSequencerStateAsync(_projectId);
            if (!r.Succeeded && !_sequencer.InProgress)
                _error = r.Error ?? "Rebase failed.";
            else if (_sequencer.InProgress)
                _error = "Rebase paused — resolve and continue from the banner.";
            else
                _notice = "Rebase complete.";
            await RefreshAfterMutationAsync(reloadBranches: true);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    // ---- Phase 6: conflict editor ----

    private async Task OpenConflictAsync(string path)
    {
        _busy = true; _error = null;
        try
        {
            _conflict = await Git.GetConflictAsync(_projectId, path);
            _showConflict = true;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task ResolveConflictAsync(string content)
    {
        if (_conflict is null) return;
        _showConflict = false;
        await MutateAsync(() => Git.ResolveConflictAsync(_projectId, _conflict.Path, content));
    }

    private async Task TakeConflictSideAsync(GitConflictSide side)
    {
        if (_conflict is null) return;
        _showConflict = false;
        await MutateAsync(() => Git.TakeConflictSideAsync(_projectId, _conflict.Path, side));
    }

    // ---- shared helpers ----

    private async Task MutateAsync(Func<Task<GitOperationResult>> action,
        bool reloadBranches = false, bool reloadStashes = false,
        bool reloadTags = false, bool reloadWorktrees = false, bool reloadSubmodules = false)
    {
        _busy = true; _error = null; _notice = null;
        try
        {
            var r = await action();
            if (!r.Succeeded) _error = r.Error ?? "Git command failed.";
            await RefreshAfterMutationAsync(reloadBranches, reloadStashes, reloadTags, reloadWorktrees, reloadSubmodules);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task RefreshAfterMutationAsync(
        bool reloadBranches = false, bool reloadStashes = false,
        bool reloadTags = false, bool reloadWorktrees = false, bool reloadSubmodules = false)
    {
        _status = await Git.GetStatusAsync(_projectId);
        _sequencer = await Git.GetSequencerStateAsync(_projectId);
        if (reloadBranches || _tab == Tab.Branches) _branches = (await Git.GetBranchesAsync(_projectId)).ToList();
        if (reloadStashes || _tab == Tab.Stashes) _stashes = (await Git.GetStashesAsync(_projectId)).ToList();
        if (reloadTags || _tab == Tab.Tags) _tags = (await Git.GetTagsAsync(_projectId)).ToList();
        if (reloadWorktrees || _tab == Tab.Worktrees) _worktrees = (await Git.GetWorktreesAsync(_projectId)).ToList();
        if (reloadSubmodules || _tab == Tab.Submodules) _submodules = (await Git.GetSubmodulesAsync(_projectId)).ToList();
        if (_tab == Tab.History) _commits = (await Git.GetHistoryAsync(_projectId, 100)).ToList();
        if (_tab == Tab.Reflog) _reflog = (await Git.GetReflogAsync(_projectId, 100)).ToList();
    }

    private void OnLine(ProcessOutputEvent e)
    {
        _output.Add(e);
        StateHasChanged();
    }

    private async Task CopyAsync(string text)
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", text); }
        catch { /* clipboard unavailable */ }
    }

    private CommandPreview? Preview(GitCommandCatalog.GitCommandDefinition def)
    {
        if (_ctx is null) return null;
        var req = GitCommandPreviewBuilder.BuildRequest(def, _ctx.ProjectId, _ctx.ExecutablePath, _ctx.WorkingDirectory);
        return GitCommandPreviewBuilder.BuildPreview(req, [new CommandContextChip("Risk", GitCommandPreviewBuilder.RiskLabel(def.Risk))]);
    }

    private static IReadOnlyList<string> PathArgs(GitStatusEntry e) =>
        e.OriginalPath is not null ? [e.Path, e.OriginalPath] : [e.Path];

    private Task RunConfirmAsync()
    {
        var action = _confirm?.Action;
        _confirm = null;
        return action?.Invoke() ?? Task.CompletedTask;
    }

    private void CancelConfirm() => _confirm = null;

    private static string SafeName(string s) => s.Trim();
    private static string ShortTarget(string target) =>
        target.Length == 40 && target.All(Uri.IsHexDigit) ? target[..8] : target;
    private static string LocalName(string remoteBranch)
    {
        var slash = remoteBranch.IndexOf('/');
        return slash >= 0 ? remoteBranch[(slash + 1)..] : remoteBranch;
    }

    private static string FolderFromUrl(string url)
    {
        var u = url.Trim().TrimEnd('/');
        var slash = u.LastIndexOf('/');
        var name = slash >= 0 ? u[(slash + 1)..] : u;
        if (name.EndsWith(".git", StringComparison.OrdinalIgnoreCase)) name = name[..^4];
        return name;
    }

    private static string TabLabel(Tab t) => t.ToString();
}
