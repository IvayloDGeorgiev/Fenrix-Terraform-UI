@page "/source-control"
@page "/projects/{ProjectId:guid}/source-control"
@using Fenrix.IaCStudio.Application.Abstractions.Git
@using Fenrix.IaCStudio.Application.Abstractions.Projects
@using Fenrix.IaCStudio.Application.Git
@using Fenrix.IaCStudio.Contracts.Git
@using Fenrix.IaCStudio.Contracts.Projects
@using Fenrix.IaCStudio.Contracts.Terraform
@using Fenrix.IaCStudio.Domain.Environments
@using Fenrix.IaCStudio.Domain.Git
@using Fenrix.IaCStudio.Domain.Projects
@inject IGitService Git
@inject IProjectService Projects
@inject IProjectImportScanner ImportScanner
@inject IJSRuntime JS
@inject NavigationManager Nav

@if (_project is not null)
{
    <ProjectHeader ProjectId="_projectId" Name="@_project.Name" Active="ProjectHeader.ProjectPage.SourceControl"
                   Trail="@(_ctx is { IsRepository: true } ? _status.Branch : null)">
        <Actions>
            <button class="fx-btn sm" @onclick="() => _showPicker = true" disabled="@_busy" title="Switch project">
                <span class="fx-ico"><Icon Name="folder" Size="13" /></span> Switch
            </button>
            <button class="fx-btn sm" @onclick="OpenCloneDialog" title="Clone a remote repository">
                <span class="fx-ico"><Icon Name="download" Size="13" /></span> Clone
            </button>
            @if (_ctx is not null)
            {
                <button class="fx-btn sm" @onclick="RefreshAsync" title="Refresh Git state" disabled="@_busy">
                    <span class="fx-ico"><Icon Name="refresh" Size="13" /></span> Refresh
                </button>
            }
        </Actions>
    </ProjectHeader>
}
else
{
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:16px;">
        <div style="flex:1;">
            <h1 class="fx-page-title" style="margin:0;">Source control</h1>
            <div class="fx-page-sub" style="margin:2px 0 0;">Git status, commits and branches. Remote operations run locally against configured credentials.</div>
        </div>
        <button class="fx-btn" @onclick="() => _showPicker = true" disabled="@_busy" title="Choose a project" style="min-width:200px;justify-content:space-between;">
            <span style="display:flex;align-items:center;gap:6px;overflow:hidden;">
                <span class="fx-ico"><Icon Name="folder" Size="14" /></span>
                <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">Select a project…</span>
            </span>
            <span class="fx-ico" style="color:var(--fx-faint);"><Icon Name="chevron-down" Size="14" /></span>
        </button>
        <button class="fx-btn" @onclick="OpenCloneDialog" title="Clone a remote repository">
            <span class="fx-ico"><Icon Name="download" Size="14" /></span> Clone
        </button>
    </div>
}

@if (_project is null)
{
    <div class="fx-card" style="text-align:center;padding:40px;">
        <div style="color:var(--fx-accent);margin-bottom:10px;"><Icon Name="git-branch" Size="28" /></div>
        <h2 style="font-size:16px;margin:0 0 6px;">@(_projectList.Count == 0 ? "No projects yet" : "Select a project")</h2>
        <p style="color:var(--fx-dim);font-size:13px;margin:0;">
            @(_projectList.Count == 0 ? "Create or import a project, or clone a repository to get started." : "Choose a project above to see its source control.")
        </p>
    </div>
}
else if (_ctx is null || !_ctx.IsRepository)
{
    <div class="fx-card" style="text-align:center;padding:36px;">
        <div style="color:var(--fx-warn);margin-bottom:10px;"><Icon Name="git-branch" Size="26" /></div>
        <h2 style="font-size:16px;margin:0 0 6px;">@_project.Name is not a Git repository</h2>
        <p style="color:var(--fx-dim);font-size:13px;margin:0 0 16px;">
            @(_ctx is null ? "Git was not found. Set the executable in Settings or install Git on your PATH." : "Initialise a repository to start tracking changes.")
        </p>
        @if (_ctx is not null)
        {
            <button class="fx-btn accent" @onclick="InitRepoAsync" disabled="@_busy">
                <span class="fx-ico"><Icon Name="git-branch" Size="14" /></span> Initialise repository
            </button>
            <div class="fx-mono" style="margin-top:12px;color:var(--fx-faint);font-size:12px;">git init · @_project.RootPath</div>
        }
    </div>
}
else
{
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:14px;flex-wrap:wrap;">
        <span class="fx-chip" title="Current branch">
            <span class="fx-ico"><Icon Name="git-branch" Size="13" /></span>
            @(_status.IsDetached ? "(detached)" : _status.Branch ?? "—")
        </span>
        @if (_status.HasUpstream)
        {
            <span class="fx-chip" title="Upstream">@_status.Upstream</span>
        }
        @if (_status.Ahead > 0)
        {
            <span class="fx-pill run" title="Commits ahead of upstream"><span class="fx-ico"><Icon Name="arrow-up" Size="11" /></span> @_status.Ahead</span>
        }
        @if (_status.Behind > 0)
        {
            <span class="fx-pill warn" title="Commits behind upstream"><span class="fx-ico"><Icon Name="arrow-down" Size="11" /></span> @_status.Behind</span>
        }
        @if (_status.HasConflicts)
        {
            <span class="fx-pill fail" title="Merge conflicts present"><span class="fx-ico"><Icon Name="alert" Size="11" /></span> Conflicts</span>
        }
        <div style="flex:1;"></div>
        <button class="fx-btn sm" @onclick="() => RunRemoteAsync(RemoteOp.Fetch)" disabled="@_busy" title="git fetch --all --prune">
            <span class="fx-ico"><Icon Name="download" Size="13" /></span> Fetch
        </button>
        <button class="fx-btn sm" @onclick="() => RunRemoteAsync(RemoteOp.Pull)" disabled="@_busy" title="git pull">
            <span class="fx-ico"><Icon Name="arrow-down" Size="13" /></span> Pull
        </button>
        <button class="fx-btn sm" @onclick="() => RunRemoteAsync(RemoteOp.Push)" disabled="@_busy" title="git push">
            <span class="fx-ico"><Icon Name="arrow-up" Size="13" /></span> Push
        </button>
    </div>

    @if (_sequencer.InProgress)
    {
        <div class="fx-card" style="border-color:@(_sequencer.HasConflicts ? "var(--fx-danger)" : "var(--fx-warn)");margin-bottom:14px;padding:12px 14px;">
            <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                <span class="fx-ico" style="color:@(_sequencer.HasConflicts ? "var(--fx-danger)" : "var(--fx-warn)");"><Icon Name="alert" Size="15" /></span>
                <span style="flex:1;min-width:200px;font-size:13px;">
                    <strong>@SequencerLabel(_sequencer.Operation) in progress.</strong>
                    @if (_sequencer.HasConflicts)
                    {
                        @($" {_sequencer.ConflictedPaths.Count} conflicted file(s) — resolve them, stage, then continue.")
                    }
                    else
                    {
                        @(" Continue when ready, or abort to unwind.")
                    }
                </span>
                <button class="fx-btn sm accent" @onclick="() => RunSequencerAsync(SequencerAction.Continue)" disabled="@(_busy || _sequencer.HasConflicts)" title="Proceed with the next step">Continue</button>
                @if (_sequencer.Operation is not GitSequencerOperation.Merge)
                {
                    <button class="fx-btn sm" @onclick="() => RunSequencerAsync(SequencerAction.Skip)" disabled="@_busy" title="Skip the current commit">Skip</button>
                }
                <button class="fx-btn sm danger" @onclick="() => RunSequencerAsync(SequencerAction.Abort)" disabled="@_busy" title="Restore the pre-operation state">Abort</button>
            </div>
        </div>
    }

    <div class="fx-tabs" style="margin-bottom:14px;">
        @foreach (var tab in _tabs)
        {
            <button class="fx-tab @(_tab == tab ? "active" : "")" @onclick="() => SwitchTab(tab)" disabled="@_busy">@TabLabel(tab)</button>
        }
    </div>

    @if (_error is not null)
    {
        <div class="fx-card" style="border-color:var(--fx-danger);margin-bottom:14px;padding:10px 14px;color:var(--fx-danger);font-size:13px;">
            <span class="fx-ico"><Icon Name="alert" Size="13" /></span> @_error
        </div>
    }
    @if (_notice is not null)
    {
        <div class="fx-card" style="border-color:var(--fx-accent);margin-bottom:14px;padding:10px 14px;font-size:13px;">
            <span class="fx-ico" style="color:var(--fx-accent);"><Icon Name="check" Size="13" /></span> @_notice
        </div>
    }

    <div class="fx-split">
        <div style="display:flex;flex-direction:column;gap:14px;min-width:0;">
            @if (_tab == Tab.Changes)
            {
                <div class="fx-card">
                    <div class="fx-field" style="margin-bottom:8px;">
                        <label>Commit message</label>
                        <textarea class="fx-input" rows="3" placeholder="Describe your changes…" @bind="_commitMessage" @bind:after="StateHasChanged" @bind:event="oninput"></textarea>
                    </div>
                    <label class="fx-check"><input type="checkbox" @bind="_commitStageAll" @bind:after="StateHasChanged" /> Stage all changes first <span class="hint">git add -A</span></label>
                    <label class="fx-check"><input type="checkbox" @bind="_commitAmend" @bind:after="StateHasChanged" /> Amend last commit <span class="hint">--amend</span></label>
                    <label class="fx-check"><input type="checkbox" @bind="_commitSignOff" @bind:after="StateHasChanged" /> Sign off <span class="hint">--signoff</span></label>
                    <div style="margin:10px 0;"><CommandPreviewPanel Preview="CommitPreview()" /></div>
                    <div style="display:flex;gap:8px;">
                        <button class="fx-btn accent" @onclick="CommitAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_commitMessage) || (!_commitStageAll && !_status.Staged.Any() && !_commitAmend))">
                            <span class="fx-ico"><Icon Name="git-commit" Size="13" /></span> Commit
                        </button>
                        <button class="fx-btn" @onclick="StashPushAsync" disabled="@(_busy || !_status.HasChanges)" title="Stash all changes (including untracked)">
                            <span class="fx-ico"><Icon Name="archive" Size="13" /></span> Stash
                        </button>
                        <div style="flex:1;"></div>
                        @if (_status.Unstaged.Any() || _status.Untracked.Any())
                        {
                            <button class="fx-btn sm" @onclick="StageAllAsync" disabled="@_busy" title="Stage everything">Stage all</button>
                        }
                    </div>
                </div>

                @if (!_status.HasChanges)
                {
                    <div class="fx-card fx-hint" style="text-align:center;padding:24px;">Working tree clean — nothing to commit.</div>
                }
                @if (_status.Conflicted.Any())
                {
                    <div class="fx-card">
                        <div class="fx-group-head" style="color:var(--fx-danger);">Conflicts (@_status.Conflicted.Count())</div>
                        @foreach (var e in _status.Conflicted)
                        {
                            <div class="fx-row @(_selectedKey == $"w:{e.Path}" ? "sel" : "")">
                                <span class="fx-code fail">@e.Code</span>
                                <button class="grow path" @onclick="() => SelectFileAsync(e, false)"><span class="fx-mono">@e.Path</span></button>
                                <button class="fx-btn sm" title="Open the 3-way conflict editor" @onclick="() => OpenConflictAsync(e.Path)" disabled="@_busy"><Icon Name="git-merge" Size="12" /> Resolve</button>
                                <button class="fx-iconbtn" title="Stage (mark resolved)" @onclick="() => StageAsync(e)"><Icon Name="plus" Size="14" /></button>
                            </div>
                        }
                    </div>
                }
                @if (_status.Staged.Any())
                {
                    <div class="fx-card">
                        <div class="fx-group-head">Staged (@_status.Staged.Count())</div>
                        @foreach (var e in _status.Staged)
                        {
                            <div class="fx-row @(_selectedKey == $"s:{e.Path}" ? "sel" : "")">
                                <span class="fx-code add">@e.Code</span>
                                <button class="grow path" @onclick="() => SelectFileAsync(e, true)">
                                    <span class="fx-mono">@e.Path</span>
                                    @if (e.OriginalPath is not null) { <span class="fx-faint fx-mono"> ← @e.OriginalPath</span> }
                                </button>
                                @if (_lfs.IsTracked(e.Path)) { <span class="fx-pill muted" style="padding:0 5px;" title="Tracked by Git LFS">LFS</span> }
                                <button class="fx-iconbtn" title="Unstage" @onclick="() => UnstageAsync(e)"><Icon Name="minus" Size="14" /></button>
                            </div>
                        }
                    </div>
                }
                @if (_status.Unstaged.Any())
                {
                    <div class="fx-card">
                        <div class="fx-group-head">Changes (@_status.Unstaged.Count())</div>
                        @foreach (var e in _status.Unstaged)
                        {
                            <div class="fx-row @(_selectedKey == $"w:{e.Path}" ? "sel" : "")">
                                <span class="fx-code warn">@e.Code</span>
                                <button class="grow path" @onclick="() => SelectFileAsync(e, false)"><span class="fx-mono">@e.Path</span></button>
                                @if (_lfs.IsTracked(e.Path)) { <span class="fx-pill muted" style="padding:0 5px;" title="Tracked by Git LFS">LFS</span> }
                                <button class="fx-iconbtn" title="Stage" @onclick="() => StageAsync(e)"><Icon Name="plus" Size="14" /></button>
                                <button class="fx-iconbtn danger" title="Discard changes" @onclick="() => ConfirmDiscard(e)"><Icon Name="restore" Size="14" /></button>
                            </div>
                        }
                    </div>
                }
                @if (_status.Untracked.Any())
                {
                    <div class="fx-card">
                        <div class="fx-group-head">Untracked (@_status.Untracked.Count())</div>
                        @foreach (var e in _status.Untracked)
                        {
                            <div class="fx-row @(_selectedKey == $"w:{e.Path}" ? "sel" : "")">
                                <span class="fx-code muted">@e.Code</span>
                                <button class="grow path" @onclick="() => SelectFileAsync(e, false)"><span class="fx-mono">@e.Path</span></button>
                                @if (_lfs.IsTracked(e.Path)) { <span class="fx-pill muted" style="padding:0 5px;" title="Tracked by Git LFS">LFS</span> }
                                <button class="fx-iconbtn" title="Stage" @onclick="() => StageAsync(e)"><Icon Name="plus" Size="14" /></button>
                                <button class="fx-iconbtn danger" title="Delete file" @onclick="() => ConfirmDiscard(e)"><Icon Name="trash" Size="14" /></button>
                            </div>
                        }
                    </div>
                }
            }
            else if (_tab == Tab.History)
            {
                <div class="fx-card">
                    <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
                        <span style="flex:1;" class="fx-group-head">History (@_commits.Count)</span>
                        <span class="fx-hint">Rebase last</span>
                        <input class="fx-input" type="number" min="1" max="50" style="width:56px;" @bind="_rebaseCount" @bind:after="StateHasChanged" />
                        <button class="fx-btn sm" @onclick="OpenRebaseAsync" disabled="@(_busy || _sequencer.InProgress)" title="Interactive rebase">
                            <span class="fx-ico"><Icon Name="git-branch" Size="12" /></span> Rebase
                        </button>
                        <button class="fx-btn sm" @onclick="OptimizeCommitGraphAsync" disabled="@_busy" title="git commit-graph write — speed up history operations">
                            <span class="fx-ico"><Icon Name="zap" Size="12" /></span> Optimise
                        </button>
                    </div>
                    @if (_commits.Count == 0)
                    {
                        <div class="fx-hint">No commits yet.</div>
                    }
                    @foreach (var c in _commits)
                    {
                        <div class="fx-row @(_selectedKey == c.Sha ? "sel" : "")">
                            <button class="grow path" style="flex-direction:column;align-items:flex-start;" @onclick="() => SelectCommitAsync(c)">
                                <span style="display:flex;align-items:center;gap:6px;">
                                    <span class="fx-mono fx-faint">@c.ShortSha</span>
                                    @if (c.IsMerge) { <span class="fx-pill muted" style="padding:0 5px;">merge</span> }
                                    <span style="overflow:hidden;text-overflow:ellipsis;">@c.Subject</span>
                                </span>
                                <span class="meta">@c.Author · @c.Date.LocalDateTime.ToString("g")</span>
                            </button>
                            <button class="fx-iconbtn" title="Cherry-pick onto current branch" @onclick="() => ConfirmCherryPick(c)" disabled="@_busy"><Icon Name="git-commit" Size="13" /></button>
                            <button class="fx-iconbtn" title="Revert this commit" @onclick="() => ConfirmRevert(c)" disabled="@_busy"><Icon Name="restore" Size="13" /></button>
                            <button class="fx-iconbtn" title="Reset current branch to here" @onclick="() => OpenResetDialog(c)" disabled="@_busy"><Icon Name="history" Size="13" /></button>
                            <button class="fx-iconbtn" title="Copy hash" @onclick="() => CopyAsync(c.Sha)"><Icon Name="copy" Size="13" /></button>
                        </div>
                    }
                </div>
            }
            else if (_tab == Tab.Reflog)
            {
                <div class="fx-card">
                    <div class="fx-group-head">Reflog (@_reflog.Count)</div>
                    <p class="fx-hint" style="margin:0 0 8px;">Where HEAD has been — recover commits lost to a reset or rebase by resetting back to one of these.</p>
                    @if (_reflog.Count == 0)
                    {
                        <div class="fx-hint">No reflog entries.</div>
                    }
                    @foreach (var r in _reflog)
                    {
                        <div class="fx-row">
                            <span class="fx-mono fx-faint" style="min-width:74px;">@r.Selector</span>
                            <span class="grow" style="min-width:0;">
                                <span class="fx-pill muted" style="padding:0 5px;">@r.Action</span>
                                <span class="fx-mono fx-faint" style="margin:0 6px;">@r.ShortSha</span>
                                <span style="overflow:hidden;text-overflow:ellipsis;">@r.Description</span>
                            </span>
                            <button class="fx-iconbtn" title="Reset current branch to @r.ShortSha" @onclick="() => OpenResetDialog(r.Sha, r.Description)" disabled="@_busy"><Icon Name="history" Size="13" /></button>
                            <button class="fx-iconbtn" title="Copy hash" @onclick="() => CopyAsync(r.Sha)"><Icon Name="copy" Size="13" /></button>
                        </div>
                    }
                </div>
            }
            else if (_tab == Tab.Tags)
            {
                @TagsTab
            }
            else if (_tab == Tab.Worktrees)
            {
                @WorktreesTab
            }
            else if (_tab == Tab.Submodules)
            {
                @SubmodulesTab
            }
            else if (_tab == Tab.Provider)
            {
                <ProviderPanel ProjectId="_projectId" OnBindingChanged="RefreshAsync" />
            }
            else if (_tab == Tab.Branches)
            {
                <div class="fx-card">
                    <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
                        <span style="flex:1;" class="fx-group-head">Local branches</span>
                        <button class="fx-btn sm accent" @onclick="OpenBranchDialog" disabled="@_busy"><span class="fx-ico"><Icon Name="plus" Size="12" /></span> New</button>
                    </div>
                    @foreach (var b in _branches.Where(x => !x.IsRemote))
                    {
                        <div class="fx-row">
                            <span class="fx-ico" style="color:@(b.IsCurrent ? "var(--fx-accent)" : "var(--fx-faint)");"><Icon Name="git-branch" Size="13" /></span>
                            <span class="grow" style="min-width:0;">
                                <span class="fx-mono" style="font-weight:@(b.IsCurrent ? "600" : "400");">@b.Name</span>
                                @if (b.Ahead > 0) { <span class="fx-faint"> ↑@b.Ahead</span> }
                                @if (b.Behind > 0) { <span class="fx-faint"> ↓@b.Behind</span> }
                            </span>
                            @if (!b.IsCurrent)
                            {
                                <button class="fx-btn sm" @onclick="() => CheckoutAsync(b)" disabled="@_busy">Checkout</button>
                                <button class="fx-btn sm" @onclick="() => ConfirmMerge(b)" disabled="@_busy" title="Merge into current"><Icon Name="git-merge" Size="12" /></button>
                                <button class="fx-iconbtn danger" @onclick="() => ConfirmDeleteBranch(b)" disabled="@_busy" title="Delete branch"><Icon Name="trash" Size="13" /></button>
                            }
                        </div>
                    }
                    @if (_branches.Any(x => x.IsRemote))
                    {
                        <div class="fx-group-head" style="margin-top:12px;">Remote branches</div>
                        @foreach (var b in _branches.Where(x => x.IsRemote))
                        {
                            <div class="fx-row">
                                <span class="fx-ico" style="color:var(--fx-faint);"><Icon Name="cloud" Size="13" /></span>
                                <span class="grow fx-mono" style="min-width:0;">@b.Name</span>
                                <button class="fx-btn sm" @onclick="() => CheckoutAsync(b)" disabled="@_busy" title="Check out a local tracking branch">Checkout</button>
                            </div>
                        }
                    }
                </div>
            }
            else if (_tab == Tab.Stashes)
            {
                <div class="fx-card">
                    <div class="fx-group-head">Stashes (@_stashes.Count)</div>
                    @if (_stashes.Count == 0)
                    {
                        <div class="fx-hint">No stashes. Use the Stash button on the Changes tab to save your working state.</div>
                    }
                    @foreach (var s in _stashes)
                    {
                        <div class="fx-row">
                            <span class="fx-ico" style="color:var(--fx-faint);"><Icon Name="archive" Size="13" /></span>
                            <span class="grow" style="min-width:0;">
                                <span class="fx-mono fx-faint">@s.Reference</span>
                                <span style="margin-left:6px;">@s.Message</span>
                                @if (s.Branch is not null) { <span class="fx-faint"> · @s.Branch</span> }
                            </span>
                            <button class="fx-btn sm" @onclick="() => StashApplyAsync(s)" disabled="@_busy" title="Apply and keep">Apply</button>
                            <button class="fx-btn sm" @onclick="() => StashPopAsync(s)" disabled="@_busy" title="Apply and drop">Pop</button>
                            <button class="fx-iconbtn danger" @onclick="() => ConfirmStashDrop(s)" disabled="@_busy" title="Drop"><Icon Name="trash" Size="13" /></button>
                        </div>
                    }
                </div>
            }
        </div>

        <div style="display:flex;flex-direction:column;gap:14px;min-width:0;">
            @if (_output.Count > 0)
            {
                <div class="fx-card">
                    <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
                        <span class="fx-ico" style="color:var(--fx-accent);"><Icon Name="terminal" Size="15" /></span>
                        <span style="flex:1;font-size:13px;font-weight:500;">Output</span>
                        <button class="fx-iconbtn" title="Clear" @onclick="() => _output.Clear()"><Icon Name="x" Size="13" /></button>
                    </div>
                    <OutputConsole Lines="_output" />
                </div>
            }
            <div class="fx-card" style="min-height:200px;">
                @if (_blamePath is not null)
                {
                    <div class="fx-tabs" style="margin-bottom:10px;">
                        <button class="fx-tab @(_rightView == RightView.Diff ? "active" : "")" @onclick="() => _rightView = RightView.Diff">Diff</button>
                        <button class="fx-tab @(_rightView == RightView.Blame ? "active" : "")" @onclick="ShowBlameAsync">Blame</button>
                    </div>
                }
                @if (_rightView == RightView.Blame && _blamePath is not null)
                {
                    <GitBlameView Blame="_blame" Loading="_blameLoading" />
                }
                else
                {
                    @if (_diffSelectable && _diffFile is { IsBinary: false } && _diffFile.Hunks.Count > 0)
                    {
                        <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
                            <span class="fx-hint" style="flex:1;">@_selectedLines.Count line(s) selected — click lines to choose.</span>
                            <button class="fx-btn sm accent" @onclick="ApplySelectedLinesAsync" disabled="@(_busy || _selectedLines.Count == 0)">
                                @(_diffIsStaged ? "Unstage selected lines" : "Stage selected lines")
                            </button>
                        </div>
                    }
                    <GitDiffView File="_diffFile" Loading="_diffLoading" EmptyText="@_diffEmpty"
                                 Selectable="_diffSelectable" SelectedLines="_selectedLines" OnToggleLine="ToggleLine" />
                }
            </div>
        </div>
    </div>
}

@if (_showClone)
{
    <Modal Title="Clone repository" IconName="download" OnClose="() => _showClone = false" Wide="true">
        <ChildContent>
        <div class="fx-field">
            <label>Repository URL</label>
            <input class="fx-input fx-mono" placeholder="https://github.com/org/repo.git" @bind="_cloneUrl" @bind:after="OnCloneChanged" @bind:event="oninput" />
        </div>
        <div class="fx-tabs" style="margin:6px 0 12px;">
            <button class="fx-tab @(_cloneToExisting ? "" : "active")" @onclick="() => SetCloneMode(false)">New project</button>
            <button class="fx-tab @(_cloneToExisting ? "active" : "")" @onclick="() => SetCloneMode(true)">Existing project</button>
        </div>
        @if (!_cloneToExisting)
        {
            <div class="fx-field">
                <label>Project name</label>
                <input class="fx-input" placeholder="repo" @bind="_cloneName" @bind:after="OnCloneChanged" @bind:event="oninput" />
            </div>
            <div class="fx-field">
                <label>Location</label>
                <input class="fx-input fx-mono" placeholder="C:\path\to\projects" @bind="_cloneLocation" @bind:after="OnCloneChanged" @bind:event="oninput" />
            </div>
        }
        else
        {
            <div class="fx-field">
                <label>Add to project</label>
                <select class="fx-select" value="@_cloneExistingId" @onchange="OnCloneExistingChanged">
                    <option value="@Guid.Empty">Select a project…</option>
                    @foreach (var p in _projectList)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                </select>
            </div>
            @if (_cloneEnvironments.Count > 0)
            {
                <div class="fx-field">
                    <label>Environment</label>
                    <select class="fx-select" @bind="_cloneEnvironment" @bind:after="OnCloneChanged">
                        @foreach (var e in _cloneEnvironments)
                        {
                            <option value="@e.Name">@e.Name@(e.IsProduction ? " (production)" : "")</option>
                        }
                    </select>
                    <p class="fx-hint" style="margin:6px 0 0;">Clones into a subfolder of this project for the selected environment.</p>
                </div>
            }
            <div class="fx-field">
                <label>Folder name</label>
                <input class="fx-input" placeholder="repo" @bind="_cloneName" @bind:after="OnCloneChanged" @bind:event="oninput" />
            </div>
        }

        <div class="fx-field">
            <label>Sparse checkout <span style="color:var(--fx-faint);">(optional — one path per line, e.g. environments/dev)</span></label>
            <textarea class="fx-textarea fx-mono" rows="2" placeholder="environments/dev" @bind="_cloneSparsePaths"></textarea>
            <div class="fx-hint">Leave blank for a full clone. Paths listed here do a partial + sparse checkout of just those directories.</div>
        </div>

        @if (_cloneValidation is not null)
        {
            <div class="fx-hint" style="color:var(--fx-warn);margin-top:4px;"><span class="fx-ico"><Icon Name="alert" Size="13" /></span> @_cloneValidation</div>
        }
        <div style="margin-top:10px;"><CommandPreviewPanel Preview="_clonePreview" /></div>
        @if (_output.Count > 0 && _busy)
        {
            <div style="margin-top:10px;"><OutputConsole Lines="_output" /></div>
        }

        </ChildContent>
        <Footer>
            <button class="fx-btn" @onclick="() => _showClone = false" disabled="@_busy">Cancel</button>
            <button class="fx-btn accent" @onclick="CloneAsync" disabled="@(_busy || _cloneValidation is not null || string.IsNullOrWhiteSpace(_cloneUrl))">
                <span class="fx-ico"><Icon Name="download" Size="13" /></span> @(_busy ? "Cloning…" : "Clone")
            </button>
        </Footer>
    </Modal>
}

@if (_showBranchDialog)
{
    <Modal Title="New branch" IconName="git-branch" OnClose="() => _showBranchDialog = false">
        <ChildContent>
        <div class="fx-field">
            <label>Branch name</label>
            <input class="fx-input fx-mono" placeholder="feature/my-change" @bind="_newBranchName" @bind:after="StateHasChanged" @bind:event="oninput" />
        </div>
        <label class="fx-check"><input type="checkbox" @bind="_newBranchCheckout" @bind:after="StateHasChanged" /> Check out after creating</label>
        <div style="margin-top:10px;"><CommandPreviewPanel Preview="@Preview(GitCommandCatalog.BranchCreate(SafeName(_newBranchName), null, _newBranchCheckout))" /></div>
        </ChildContent>
        <Footer>
            <button class="fx-btn" @onclick="() => _showBranchDialog = false" disabled="@_busy">Cancel</button>
            <button class="fx-btn accent" @onclick="CreateBranchAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_newBranchName))">Create</button>
        </Footer>
    </Modal>
}

@if (_showReset)
{
    <Modal Title="Reset branch" IconName="history" OnClose="() => _showReset = false">
        <ChildContent>
        <p style="font-size:13px;margin:0 0 10px;">
            Move <span class="fx-mono">@(_status.Branch ?? "HEAD")</span> to
            <span class="fx-mono">@ShortTarget(_resetTarget)</span>@(string.IsNullOrEmpty(_resetSubject) ? "" : $" — {_resetSubject}").
        </p>
        <div class="fx-field">
            <label>Mode</label>
            <label class="fx-check"><input type="radio" name="resetmode" checked="@(_resetMode == GitResetMode.Soft)" @onchange="() => _resetMode = GitResetMode.Soft" /> Soft <span class="hint">keep index &amp; working tree (changes staged)</span></label>
            <label class="fx-check"><input type="radio" name="resetmode" checked="@(_resetMode == GitResetMode.Mixed)" @onchange="() => _resetMode = GitResetMode.Mixed" /> Mixed <span class="hint">reset index, keep working tree (changes unstaged)</span></label>
            <label class="fx-check"><input type="radio" name="resetmode" checked="@(_resetMode == GitResetMode.Hard)" @onchange="() => _resetMode = GitResetMode.Hard" /> Hard <span class="hint" style="color:var(--fx-danger);">discard all uncommitted changes</span></label>
        </div>
        @if (_resetMode == GitResetMode.Hard)
        {
            <div class="fx-hint" style="color:var(--fx-danger);margin:4px 0;"><span class="fx-ico"><Icon Name="alert" Size="13" /></span> A hard reset permanently discards uncommitted work. Recover via the reflog if needed.</div>
        }
        <div style="margin-top:10px;"><CommandPreviewPanel Preview="ResetPreview()" /></div>
        </ChildContent>
        <Footer>
            <button class="fx-btn" @onclick="() => _showReset = false" disabled="@_busy">Cancel</button>
            <button class="fx-btn @(_resetMode == GitResetMode.Hard ? "danger" : "accent")" @onclick="ApplyResetAsync" disabled="@_busy">Reset (@_resetMode.ToString().ToLowerInvariant())</button>
        </Footer>
    </Modal>
}

@if (_showTag)
{
    <Modal Title="New tag" IconName="bookmark" OnClose="() => _showTag = false">
        <ChildContent>
        <div class="fx-field">
            <label>Tag name</label>
            <input class="fx-input fx-mono" placeholder="v1.0.0" @bind="_tagName" @bind:after="StateHasChanged" @bind:event="oninput" />
        </div>
        <label class="fx-check"><input type="checkbox" @bind="_tagAnnotated" @bind:after="StateHasChanged" /> Annotated <span class="hint">-a -m … (recommended for releases)</span></label>
        @if (_tagAnnotated)
        {
            <div class="fx-field">
                <label>Message</label>
                <input class="fx-input" placeholder="Release 1.0.0" @bind="_tagMessage" @bind:after="StateHasChanged" @bind:event="oninput" />
            </div>
        }
        <div class="fx-field">
            <label>Target</label>
            <input class="fx-input fx-mono" placeholder="HEAD or a commit SHA" @bind="_tagTarget" @bind:after="StateHasChanged" @bind:event="oninput" />
        </div>
        <div style="margin-top:10px;"><CommandPreviewPanel Preview="TagPreview()" /></div>
        </ChildContent>
        <Footer>
            <button class="fx-btn" @onclick="() => _showTag = false" disabled="@_busy">Cancel</button>
            <button class="fx-btn accent" @onclick="CreateTagAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_tagName))">Create tag</button>
        </Footer>
    </Modal>
}

@if (_showWorktree)
{
    <Modal Title="Add worktree" IconName="folder" OnClose="() => _showWorktree = false">
        <ChildContent>
        <div class="fx-field">
            <label>Location</label>
            <input class="fx-input fx-mono" placeholder="C:\path\to\new-worktree" @bind="_worktreePath" @bind:after="StateHasChanged" @bind:event="oninput" />
        </div>
        <label class="fx-check"><input type="checkbox" @bind="_worktreeNewBranch" @bind:after="StateHasChanged" /> Create a new branch</label>
        <div class="fx-field">
            <label>@(_worktreeNewBranch ? "New branch name" : "Branch / commit to check out")</label>
            <input class="fx-input fx-mono" placeholder="@(_worktreeNewBranch ? "feature/x" : "main")" @bind="_worktreeBranch" @bind:after="StateHasChanged" @bind:event="oninput" />
        </div>
        <div style="margin-top:10px;"><CommandPreviewPanel Preview="WorktreePreview()" /></div>
        </ChildContent>
        <Footer>
            <button class="fx-btn" @onclick="() => _showWorktree = false" disabled="@_busy">Cancel</button>
            <button class="fx-btn accent" @onclick="AddWorktreeAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_worktreePath))">Add worktree</button>
        </Footer>
    </Modal>
}

@if (_confirm is not null)
{
    <Modal Title="@_confirm.Title" IconName="alert" OnClose="CancelConfirm">
        <ChildContent>
        <p style="font-size:13px;margin:0 0 10px;">@_confirm.Message</p>
        @if (_confirm.Preview is not null)
        {
            <CommandPreviewPanel Preview="_confirm.Preview" />
        }
        </ChildContent>
        <Footer>
            <button class="fx-btn" @onclick="CancelConfirm" disabled="@_busy">Cancel</button>
            <button class="fx-btn danger" @onclick="RunConfirmAsync" disabled="@_busy">@_confirm.ActionLabel</button>
        </Footer>
    </Modal>
}

@if (_showRebase)
{
    <RebaseDialog Base="_rebaseBase" Steps="_rebaseSteps" Busy="_busy" Preview="_rebasePreview"
                  OnClose="() => _showRebase = false" OnApply="StartRebaseAsync" />
}

@if (_showConflict && _conflict is not null)
{
    <ConflictEditor File="_conflict" Busy="_busy"
                    OnClose="() => _showConflict = false" OnResolve="ResolveConflictAsync" OnTakeSide="TakeConflictSideAsync" />
}

@if (_showPicker)
{
    <ProjectPickerDialog Projects="_projectList" SelectedId="_projectId" OnSelect="OnPickProject" OnClose="() => _showPicker = false" />
}

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private enum Tab { Changes, History, Branches, Tags, Stashes, Reflog, Worktrees, Submodules, Provider }
    private enum RemoteOp { Fetch, Pull, Push }
    private enum RightView { Diff, Blame }
    private static readonly Tab[] _tabs =
        [Tab.Changes, Tab.History, Tab.Branches, Tab.Tags, Tab.Stashes, Tab.Reflog, Tab.Worktrees, Tab.Submodules, Tab.Provider];

    private List<ProjectSummary> _projectList = [];
    private Guid _projectId;
    private InfrastructureProject? _project;
    private GitCommandContext? _ctx;
    private GitStatus _status = GitStatus.NotARepository;
    private List<GitBranch> _branches = [];
    private List<GitCommit> _commits = [];
    private List<GitStash> _stashes = [];
    private List<GitReflogEntry> _reflog = [];
    private List<GitTag> _tags = [];
    private List<GitWorktree> _worktrees = [];
    private List<GitSubmodule> _submodules = [];
    private GitSequencerState _sequencer = GitSequencerState.Idle;
    private GitLfsInfo _lfs = GitLfsInfo.NotInstalled;

    private Tab _tab = Tab.Changes;
    private bool _busy;
    private string? _error;
    private string? _notice;

    private readonly List<ProcessOutputEvent> _output = [];

    // diff / blame panel
    private RightView _rightView = RightView.Diff;
    private GitDiffFile? _diffFile;
    private bool _diffLoading;
    private string _diffEmpty = "Select a file to see its changes.";
    private string? _selectedKey;
    private GitBlame? _blame;
    private bool _blameLoading;
    private string? _blamePath;

    // reset dialog
    private bool _showReset;
    private GitResetMode _resetMode = GitResetMode.Mixed;
    private string _resetTarget = "HEAD";
    private string _resetSubject = "";

    // tag dialog
    private bool _showTag;
    private string _tagName = "";
    private string _tagMessage = "";
    private bool _tagAnnotated = true;
    private string _tagTarget = "HEAD";

    // worktree dialog
    private bool _showWorktree;
    private string _worktreePath = "";
    private string _worktreeBranch = "";
    private bool _worktreeNewBranch = true;

    // line staging
    private bool _diffSelectable;
    private bool _diffIsStaged;
    private readonly HashSet<(int Hunk, int Line)> _selectedLines = [];

    // rebase dialog
    private bool _showRebase;
    private int _rebaseCount = 5;
    private string _rebaseBase = "HEAD";
    private List<GitRebaseStep> _rebaseSteps = [];
    private CommandPreview? _rebasePreview;

    // conflict editor
    private bool _showConflict;
    private GitConflictFile? _conflict;

    // commit box
    private string _commitMessage = "";
    private bool _commitAmend, _commitSignOff, _commitStageAll;

    // dialogs
    private bool _showPicker;
    private bool _showClone;
    private string _cloneUrl = "", _cloneName = "", _cloneLocation = "", _cloneSparsePaths = "";
    private bool _cloneToExisting;
    private Guid _cloneExistingId;
    private List<ProjectEnvironment> _cloneEnvironments = [];
    private string _cloneEnvironment = "";
    private string? _cloneValidation;
    private CommandPreview? _clonePreview;

    private bool _showBranchDialog;
    private string _newBranchName = "";
    private bool _newBranchCheckout = true;

    private ConfirmState? _confirm;
    private sealed record ConfirmState(string Title, string Message, string ActionLabel, CommandPreview? Preview, Func<Task> Action);

    private Guid _loadedId = Guid.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Guid.Empty && _projectList.Count == 0)
            _projectList = (await Projects.ListAsync()).ToList();

        if (ProjectId != Guid.Empty && ProjectId != _projectId)
        {
            _projectId = ProjectId;
            await SelectProjectAsync(ProjectId);
        }
        _loadedId = ProjectId;
    }

    private async Task OnPickProject(ProjectSummary p)
    {
        _showPicker = false;
        if (p.Id == _projectId) return;
        _projectId = p.Id;
        await SelectProjectAsync(p.Id);
    }

    private async Task SelectProjectAsync(Guid id)
    {
        _busy = true; _error = null; _notice = null;
        ResetPanels();
        try
        {
            _project = await Projects.GetAsync(id);
            if (_project is null) { _ctx = null; return; }
            _ctx = await Git.ResolveContextAsync(id);
            if (_ctx is { IsRepository: true })
                await RefreshAsync();
        }
        finally { _busy = false; }
    }

    private async Task RefreshAsync()
    {
        if (_ctx is null) return;
        _busy = true; _error = null;
        try
        {
            _ctx = await Git.ResolveContextAsync(_projectId) ?? _ctx;
            _status = await Git.GetStatusAsync(_projectId);
            _sequencer = await Git.GetSequencerStateAsync(_projectId);
            _lfs = await Git.GetLfsInfoAsync(_projectId);
            await LoadTabAsync(_tab);
            await RefreshDiffAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task LoadTabAsync(Tab tab)
    {
        switch (tab)
        {
            case Tab.History: _commits = (await Git.GetHistoryAsync(_projectId, 100)).ToList(); break;
            case Tab.Branches: _branches = (await Git.GetBranchesAsync(_projectId)).ToList(); break;
            case Tab.Stashes: _stashes = (await Git.GetStashesAsync(_projectId)).ToList(); break;
            case Tab.Tags: _tags = (await Git.GetTagsAsync(_projectId)).ToList(); break;
            case Tab.Reflog: _reflog = (await Git.GetReflogAsync(_projectId, 100)).ToList(); break;
            case Tab.Worktrees: _worktrees = (await Git.GetWorktreesAsync(_projectId)).ToList(); break;
            case Tab.Submodules: _submodules = (await Git.GetSubmodulesAsync(_projectId)).ToList(); break;
        }
    }

    private async Task SwitchTab(Tab tab)
    {
        _tab = tab;
        _busy = true;
        try { await LoadTabAsync(tab); }
        finally { _busy = false; }
    }

    private void ResetPanels()
    {
        _status = GitStatus.NotARepository;
        _branches = []; _commits = []; _stashes = [];
        _reflog = []; _tags = []; _worktrees = []; _submodules = [];
        _sequencer = GitSequencerState.Idle; _lfs = GitLfsInfo.NotInstalled;
        _diffFile = null; _blame = null; _selectedKey = null; _rightView = RightView.Diff; _output.Clear();
        _commitMessage = ""; _commitAmend = false; _commitSignOff = false; _commitStageAll = false;
    }

    // ---- repository ----

    private async Task InitRepoAsync()
    {
        _busy = true; _error = null;
        try
        {
            var r = await Git.InitAsync(_projectId);
            if (!r.Succeeded) { _error = r.Error ?? "git init failed."; return; }
            _notice = "Initialised a Git repository.";
            await SelectProjectAsync(_projectId);
        }
        finally { _busy = false; }
    }

    private async Task RunRemoteAsync(RemoteOp op)
    {
        _busy = true; _error = null; _notice = null; _output.Clear();
        var progress = new Progress<ProcessOutputEvent>(OnLine);
        try
        {
            var r = op switch
            {
                RemoteOp.Fetch => await Git.FetchAsync(_projectId, progress),
                RemoteOp.Pull => await Git.PullAsync(_projectId, progress),
                _ => await Git.PushAsync(_projectId, forceWithLease: false, progress)
            };
            if (!r.Succeeded) _error = r.Error ?? $"git {op.ToString().ToLowerInvariant()} failed.";
            else _notice = $"{op} complete.";
            await RefreshAfterMutationAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    // ---- changes / staging / commit ----

    private async Task StageAsync(GitStatusEntry entry)
        => await MutateAsync(() => Git.StageAsync(_projectId, PathArgs(entry)));

    private async Task UnstageAsync(GitStatusEntry entry)
        => await MutateAsync(() => Git.UnstageAsync(_projectId, [entry.Path]));

    private Task StageAllAsync() => MutateAsync(() => Git.StageAllAsync(_projectId));

    private void ConfirmDiscard(GitStatusEntry entry)
    {
        var def = GitCommandCatalog.Discard(PathArgs(entry), entry.IsUntracked);
        _confirm = new ConfirmState(
            entry.IsUntracked ? "Delete untracked file" : "Discard changes",
            entry.IsUntracked
                ? $"Permanently delete '{entry.Path}'? This cannot be undone."
                : $"Discard all uncommitted changes to '{entry.Path}'? This restores it from the last commit.",
            entry.IsUntracked ? "Delete" : "Discard",
            Preview(def),
            () => MutateAsync(() => Git.DiscardAsync(_projectId, PathArgs(entry), entry.IsUntracked)));
    }

    private async Task CommitAsync()
    {
        if (string.IsNullOrWhiteSpace(_commitMessage)) return;
        _busy = true; _error = null; _notice = null;
        try
        {
            var req = new GitCommitRequest(_commitMessage.Trim(), _commitStageAll, _commitAmend, _commitSignOff);
            var r = await Git.CommitAsync(_projectId, req);
            if (!r.Succeeded) { _error = r.Error ?? "Commit failed."; return; }
            _notice = "Committed.";
            _commitMessage = ""; _commitAmend = false;
            await RefreshAfterMutationAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private CommandPreview? CommitPreview() =>
        string.IsNullOrWhiteSpace(_commitMessage)
            ? null
            : Preview(GitCommandCatalog.Commit(new GitCommitRequest(_commitMessage.Trim(), _commitStageAll, _commitAmend, _commitSignOff)));

    // ---- branches ----

    private void OpenBranchDialog()
    {
        _newBranchName = ""; _newBranchCheckout = true; _showBranchDialog = true;
    }

    private async Task CreateBranchAsync()
    {
        _showBranchDialog = false;
        await MutateAsync(() => Git.CreateBranchAsync(_projectId, SafeName(_newBranchName), _newBranchCheckout), reloadBranches: true);
    }

    private Task CheckoutAsync(GitBranch b)
        => MutateAsync(() => Git.CheckoutAsync(_projectId, b.IsRemote ? LocalName(b.Name) : b.Name), reloadBranches: true);

    private void ConfirmDeleteBranch(GitBranch b)
    {
        _confirm = new ConfirmState(
            "Delete branch",
            $"Delete branch '{b.Name}'? Use force if it has unmerged commits.",
            "Delete",
            Preview(GitCommandCatalog.BranchDelete(b.Name, force: false)),
            () => MutateAsync(() => Git.DeleteBranchAsync(_projectId, b.Name, force: true), reloadBranches: true));
    }

    private void ConfirmMerge(GitBranch b)
    {
        _confirm = new ConfirmState(
            "Merge branch",
            $"Merge '{b.Name}' into the current branch ({_status.Branch})?",
            "Merge",
            Preview(GitCommandCatalog.Merge(b.Name, noFastForward: false)),
            () => MergeAsync(b.Name));
    }

    private async Task MergeAsync(string branch)
    {
        _busy = true; _error = null; _notice = null;
        try
        {
            var r = await Git.MergeAsync(_projectId, branch);
            if (r.HasConflicts)
                _error = $"Merge stopped with conflicts in {r.ConflictedPaths.Count} file(s). Resolve them, stage, and commit — or abort.";
            else if (!r.Succeeded)
                _error = "Merge failed. See output.";
            else
                _notice = $"Merged '{branch}'.";
            await RefreshAfterMutationAsync(reloadBranches: true);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private Task AbortMergeAsync() => MutateAsync(() => Git.AbortMergeAsync(_projectId), reloadBranches: true);

    // ---- stashes ----

    private Task StashPushAsync()
        => MutateAsync(() => Git.StashPushAsync(_projectId, string.IsNullOrWhiteSpace(_commitMessage) ? null : _commitMessage.Trim(), includeUntracked: true), reloadStashes: true);

    private Task StashApplyAsync(GitStash s) => MutateAsync(() => Git.StashApplyAsync(_projectId, s.Index), reloadStashes: true);
    private Task StashPopAsync(GitStash s) => MutateAsync(() => Git.StashPopAsync(_projectId, s.Index), reloadStashes: true);

    private void ConfirmStashDrop(GitStash s)
    {
        _confirm = new ConfirmState(
            "Drop stash",
            $"Permanently drop {s.Reference} ({s.Message})?",
            "Drop",
            Preview(GitCommandCatalog.StashDrop(s.Index)),
            () => MutateAsync(() => Git.StashDropAsync(_projectId, s.Index), reloadStashes: true));
    }

    // ---- diff selection ----

    private async Task SelectFileAsync(GitStatusEntry entry, bool staged)
    {
        var key = $"{(staged ? "s" : "w")}:{entry.Path}";
        _selectedKey = key;
        _rightView = RightView.Diff;
        _blame = null;
        _blamePath = entry.IsUntracked ? null : entry.Path;   // blame only makes sense for tracked files
        _selectedLines.Clear();
        _diffIsStaged = staged;
        _diffSelectable = !entry.IsUntracked && !entry.IsConflicted;   // partial staging for tracked, non-conflicted files
        _diffLoading = true; _diffFile = null; StateHasChanged();

        var source = entry.IsUntracked ? GitDiffSource.Untracked : staged ? GitDiffSource.Staged : GitDiffSource.WorkTree;
        var spec = new GitDiffSpec(source, Path: entry.Path);
        try
        {
            var files = await Git.GetDiffAsync(_projectId, spec);
            _diffFile = files.FirstOrDefault();
            _diffEmpty = "No changes to show for this file.";
        }
        finally { _diffLoading = false; }
    }

    private async Task ShowBlameAsync()
    {
        if (_blamePath is null) return;
        _rightView = RightView.Blame;
        if (_blame?.Path == _blamePath) return;
        _blameLoading = true; _blame = null; StateHasChanged();
        try { _blame = await Git.GetBlameAsync(_projectId, _blamePath); }
        finally { _blameLoading = false; }
    }

    private async Task SelectCommitAsync(GitCommit commit)
    {
        _selectedKey = commit.Sha;
        _rightView = RightView.Diff;
        _diffSelectable = false; _blamePath = null; _selectedLines.Clear();
        _diffLoading = true; _diffFile = null; StateHasChanged();
        try
        {
            var files = await Git.GetDiffAsync(_projectId, new GitDiffSpec(GitDiffSource.Commit, CommitSha: commit.Sha));
            _diffFile = files.FirstOrDefault();
            _diffEmpty = "This commit has no textual diff.";
        }
        finally { _diffLoading = false; }
    }

    private async Task RefreshDiffAsync()
    {
        // Keep a selected working/staged file's diff in sync after a refresh; drop it if it's gone.
        if (_selectedKey is null) return;
        _diffFile = null;
    }

    // ---- clone ----

    private async Task OpenCloneDialog()
    {
        _cloneUrl = ""; _cloneName = ""; _cloneSparsePaths = ""; _cloneValidation = null; _clonePreview = null;
        _cloneToExisting = false; _cloneExistingId = Guid.Empty; _cloneEnvironments = []; _cloneEnvironment = "";
        _cloneLocation = _project is not null ? (Path.GetDirectoryName(_project.RootPath.TrimEnd(Path.DirectorySeparatorChar)) ?? "") : "";
        _output.Clear();
        _showClone = true;
        await Task.CompletedTask;
    }

    private void SetCloneMode(bool existing)
    {
        _cloneToExisting = existing;
        OnCloneChanged();
    }

    private async Task OnCloneExistingChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id) && id != Guid.Empty)
        {
            _cloneExistingId = id;
            var p = await Projects.GetAsync(id);
            _cloneEnvironments = p?.Environments.OrderBy(x => x.DisplayOrder).ToList() ?? [];
            _cloneEnvironment = _cloneEnvironments.FirstOrDefault()?.Name ?? "";
        }
        else { _cloneExistingId = Guid.Empty; _cloneEnvironments = []; }
        OnCloneChanged();
    }

    private void OnCloneChanged()
    {
        if (string.IsNullOrWhiteSpace(_cloneName) && !string.IsNullOrWhiteSpace(_cloneUrl))
            _cloneName = FolderFromUrl(_cloneUrl);

        _cloneValidation = ValidateClone();
        _clonePreview = string.IsNullOrWhiteSpace(_cloneUrl)
            ? null
            : BuildClonePreview();
        StateHasChanged();
    }

    private string? ValidateClone()
    {
        if (string.IsNullOrWhiteSpace(_cloneUrl)) return null;
        var folder = string.IsNullOrWhiteSpace(_cloneName) ? FolderFromUrl(_cloneUrl) : _cloneName.Trim();
        if (string.IsNullOrWhiteSpace(folder)) return "Enter a folder or project name.";

        if (!_cloneToExisting)
        {
            if (_projectList.Any(p => string.Equals(p.Name, folder, StringComparison.OrdinalIgnoreCase)))
                return $"A project named '{folder}' already exists — switch to 'Existing project' to add to it, or choose another name.";
            if (string.IsNullOrWhiteSpace(_cloneLocation)) return "Choose a location for the new project.";
        }
        else if (_cloneExistingId == Guid.Empty)
        {
            return "Select the project to add the clone to.";
        }
        return null;
    }

    private CommandPreview? BuildClonePreview()
    {
        var folder = string.IsNullOrWhiteSpace(_cloneName) ? FolderFromUrl(_cloneUrl) : _cloneName.Trim();
        var sparse = !string.IsNullOrWhiteSpace(_cloneSparsePaths);
        var def = GitCommandCatalog.Clone(_cloneUrl.Trim(), folder, sparse);
        var exe = _ctx?.ExecutablePath ?? "git";
        var parent = CloneParent();
        var req = GitCommandPreviewBuilder.BuildRequest(def, Guid.Empty, exe, parent);
        return GitCommandPreviewBuilder.BuildPreview(req, [new CommandContextChip("Risk", GitCommandPreviewBuilder.RiskLabel(def.Risk))]);
    }

    private string CloneParent()
    {
        if (_cloneToExisting)
        {
            var p = _projectList.FirstOrDefault(x => x.Id == _cloneExistingId);
            return p?.RootPath ?? "";
        }
        return _cloneLocation.Trim();
    }

    private async Task CloneAsync()
    {
        if (_cloneValidation is not null || string.IsNullOrWhiteSpace(_cloneUrl)) return;
        _busy = true; _error = null; _notice = null; _output.Clear();
        var folder = string.IsNullOrWhiteSpace(_cloneName) ? FolderFromUrl(_cloneUrl) : _cloneName.Trim();
        var parent = CloneParent();
        var progress = new Progress<ProcessOutputEvent>(OnLine);
        try
        {
            var sparse = _cloneSparsePaths
                .Split(['\n', '\r', ','], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .ToList();
            var r = await Git.CloneAsync(
                new GitCloneRequest(_cloneUrl.Trim(), parent, folder, sparse.Count > 0 ? sparse : null), progress);
            if (!r.Succeeded) { _error = r.Error ?? "Clone failed."; return; }

            if (!_cloneToExisting)
            {
                // Register the freshly cloned folder as a Fenrix project.
                var dest = Path.Combine(parent, folder);
                var scan = await ImportScanner.ScanAsync(dest);
                var project = await Projects.ImportAsync(scan);
                _projectList = (await Projects.ListAsync()).ToList();
                _showClone = false;
                Nav.NavigateTo($"/projects/{project.Id}/source-control");
                return;
            }

            _notice = $"Cloned into '{folder}'.";
            _showClone = false;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    // ---- Phase 6: history rewriting & sequencer ----

    private void ConfirmCherryPick(GitCommit c) =>
        _confirm = new ConfirmState(
            "Cherry-pick commit",
            $"Apply commit {c.ShortSha} ({c.Subject}) onto '{_status.Branch}'? This may pause on conflicts.",
            "Cherry-pick",
            Preview(GitCommandCatalog.CherryPick([c.Sha])),
            () => MutateAsync(() => Git.CherryPickAsync(_projectId, [c.Sha])));

    private void ConfirmRevert(GitCommit c) =>
        _confirm = new ConfirmState(
            "Revert commit",
            $"Create a new commit that undoes {c.ShortSha} ({c.Subject})? This may pause on conflicts.",
            "Revert",
            Preview(GitCommandCatalog.Revert([c.Sha])),
            () => MutateAsync(() => Git.RevertAsync(_projectId, [c.Sha])));

    private void OpenResetDialog(GitCommit c) => OpenResetDialog(c.Sha, c.Subject);

    private void OpenResetDialog(string sha, string subject)
    {
        _resetTarget = sha;
        _resetSubject = subject;
        _resetMode = GitResetMode.Mixed;
        _showReset = true;
    }

    private async Task ApplyResetAsync()
    {
        _showReset = false;
        await MutateAsync(() => Git.ResetAsync(_projectId, _resetMode, _resetTarget), reloadBranches: true);
    }

    private CommandPreview? ResetPreview() => Preview(GitCommandCatalog.Reset(_resetMode, _resetTarget));

    private Task RunSequencerAsync(SequencerAction action)
    {
        if (action == SequencerAction.Abort)
            return MutateAsync(() => Git.RunSequencerAsync(_projectId, _sequencer.Operation, action), reloadBranches: true);
        return MutateAsync(() => Git.RunSequencerAsync(_projectId, _sequencer.Operation, action), reloadBranches: true);
    }

    private Task OptimizeCommitGraphAsync() => MutateAsync(() => Git.OptimizeCommitGraphAsync(_projectId));

    private static string SequencerLabel(GitSequencerOperation op) => op switch
    {
        GitSequencerOperation.Merge => "Merge",
        GitSequencerOperation.CherryPick => "Cherry-pick",
        GitSequencerOperation.Revert => "Revert",
        GitSequencerOperation.Rebase => "Rebase",
        _ => "Operation"
    };

    // ---- Phase 6: tags ----

    private RenderFragment TagsTab => @<div class="fx-card">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
            <span style="flex:1;" class="fx-group-head">Tags (@_tags.Count)</span>
            @if (_tags.Count > 0)
            {
                <button class="fx-btn sm" @onclick="() => PushAllTagsAsync()" disabled="@_busy" title="git push origin --tags">Push all</button>
            }
            <button class="fx-btn sm accent" @onclick="OpenTagDialog" disabled="@_busy"><span class="fx-ico"><Icon Name="plus" Size="12" /></span> New</button>
        </div>
        @if (_tags.Count == 0)
        {
            <div class="fx-hint">No tags yet.</div>
        }
        @foreach (var t in _tags)
        {
            <div class="fx-row">
                <span class="fx-ico" style="color:var(--fx-faint);"><Icon Name="bookmark" Size="13" /></span>
                <span class="grow" style="min-width:0;">
                    <span class="fx-mono" style="font-weight:600;">@t.Name</span>
                    <span class="fx-pill muted" style="padding:0 5px;margin-left:6px;">@(t.IsAnnotated ? "annotated" : "lightweight")</span>
                    <span class="fx-mono fx-faint" style="margin-left:6px;">@ShortTarget(t.TargetSha)</span>
                    @if (!string.IsNullOrEmpty(t.Subject)) { <span class="fx-faint" style="margin-left:6px;">@t.Subject</span> }
                </span>
                <button class="fx-btn sm" @onclick="() => PushTagAsync(t)" disabled="@_busy" title="Push this tag to origin"><Icon Name="arrow-up" Size="12" /></button>
                <button class="fx-iconbtn" @onclick="() => ConfirmDeleteRemoteTag(t)" disabled="@_busy" title="Delete tag on origin"><Icon Name="cloud" Size="13" /></button>
                <button class="fx-iconbtn danger" @onclick="() => ConfirmDeleteTag(t)" disabled="@_busy" title="Delete local tag"><Icon Name="trash" Size="13" /></button>
            </div>
        }
    </div>;

    private void OpenTagDialog()
    {
        _tagName = ""; _tagMessage = ""; _tagAnnotated = true; _tagTarget = "HEAD"; _showTag = true;
    }

    private GitTagRequest CurrentTagRequest() =>
        new(_tagName.Trim(), _tagAnnotated,
            _tagAnnotated ? (string.IsNullOrWhiteSpace(_tagMessage) ? _tagName.Trim() : _tagMessage.Trim()) : null,
            string.IsNullOrWhiteSpace(_tagTarget) || _tagTarget.Trim() == "HEAD" ? null : _tagTarget.Trim());

    private CommandPreview? TagPreview() =>
        string.IsNullOrWhiteSpace(_tagName) ? null : Preview(GitCommandCatalog.TagCreate(CurrentTagRequest()));

    private async Task CreateTagAsync()
    {
        _showTag = false;
        await MutateAsync(() => Git.CreateTagAsync(_projectId, CurrentTagRequest()), reloadTags: true);
    }

    private Task PushTagAsync(GitTag t) =>
        RunRemoteTagAsync(p => Git.PushTagAsync(_projectId, t.Name, null, p), $"Pushed tag '{t.Name}'.");

    private Task PushAllTagsAsync() =>
        RunRemoteTagAsync(p => Git.PushAllTagsAsync(_projectId, null, p), "Pushed all tags.");

    private void ConfirmDeleteTag(GitTag t) =>
        _confirm = new ConfirmState(
            "Delete local tag",
            $"Delete local tag '{t.Name}'? This does not affect the remote.",
            "Delete",
            Preview(GitCommandCatalog.TagDelete(t.Name)),
            () => MutateAsync(() => Git.DeleteTagAsync(_projectId, t.Name), reloadTags: true));

    private void ConfirmDeleteRemoteTag(GitTag t) =>
        _confirm = new ConfirmState(
            "Delete tag on origin",
            $"Delete tag '{t.Name}' on the remote 'origin'? This removes it for everyone.",
            "Delete on origin",
            Preview(GitCommandCatalog.TagDeleteRemote("origin", t.Name)),
            () => RunRemoteTagAsync(p => Git.DeleteRemoteTagAsync(_projectId, t.Name, null, p), $"Deleted '{t.Name}' on origin."));

    private async Task RunRemoteTagAsync(Func<IProgress<ProcessOutputEvent>, Task<GitOperationResult>> action, string ok)
    {
        _busy = true; _error = null; _notice = null; _output.Clear();
        var progress = new Progress<ProcessOutputEvent>(OnLine);
        try
        {
            var r = await action(progress);
            if (!r.Succeeded) _error = r.Error ?? "Tag push failed.";
            else _notice = ok;
            await RefreshAfterMutationAsync(reloadTags: true);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    // ---- Phase 6: worktrees ----

    private RenderFragment WorktreesTab => @<div class="fx-card">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
            <span style="flex:1;" class="fx-group-head">Worktrees (@_worktrees.Count)</span>
            <button class="fx-btn sm" @onclick="PruneWorktreesAsync" disabled="@_busy" title="git worktree prune">Prune</button>
            <button class="fx-btn sm accent" @onclick="OpenWorktreeDialog" disabled="@_busy"><span class="fx-ico"><Icon Name="plus" Size="12" /></span> Add</button>
        </div>
        <p class="fx-hint" style="margin:0 0 8px;">Additional checkouts of this repository, each on its own branch.</p>
        @foreach (var w in _worktrees)
        {
            <div class="fx-row">
                <span class="fx-ico" style="color:@(w.IsMain ? "var(--fx-accent)" : "var(--fx-faint)");"><Icon Name="folder" Size="13" /></span>
                <span class="grow" style="min-width:0;">
                    <span class="fx-mono">@w.Path</span>
                    @if (w.IsMain) { <span class="fx-pill muted" style="padding:0 5px;margin-left:6px;">main</span> }
                    <span class="fx-faint" style="margin-left:6px;">@(w.IsDetached ? "(detached)" : w.Branch ?? "—")</span>
                    @if (w.IsLocked) { <span class="fx-pill warn" style="padding:0 5px;margin-left:6px;">locked</span> }
                </span>
                @if (!w.IsMain)
                {
                    <button class="fx-iconbtn danger" @onclick="() => ConfirmRemoveWorktree(w)" disabled="@_busy" title="Remove worktree"><Icon Name="trash" Size="13" /></button>
                }
            </div>
        }
    </div>;

    private void OpenWorktreeDialog()
    {
        _worktreePath = ""; _worktreeBranch = ""; _worktreeNewBranch = true; _showWorktree = true;
    }

    private CommandPreview? WorktreePreview() =>
        string.IsNullOrWhiteSpace(_worktreePath) ? null
            : Preview(GitCommandCatalog.WorktreeAdd(_worktreePath.Trim(), string.IsNullOrWhiteSpace(_worktreeBranch) ? null : _worktreeBranch.Trim(), _worktreeNewBranch));

    private async Task AddWorktreeAsync()
    {
        _showWorktree = false;
        await MutateAsync(() => Git.AddWorktreeAsync(_projectId, _worktreePath.Trim(),
            string.IsNullOrWhiteSpace(_worktreeBranch) ? null : _worktreeBranch.Trim(), _worktreeNewBranch), reloadWorktrees: true);
    }

    private void ConfirmRemoveWorktree(GitWorktree w) =>
        _confirm = new ConfirmState(
            "Remove worktree",
            $"Remove the worktree at '{w.Path}'? Uncommitted changes there would be lost (force).",
            "Remove",
            Preview(GitCommandCatalog.WorktreeRemove(w.Path, force: false)),
            () => MutateAsync(() => Git.RemoveWorktreeAsync(_projectId, w.Path, force: true), reloadWorktrees: true));

    private Task PruneWorktreesAsync() => MutateAsync(() => Git.PruneWorktreesAsync(_projectId), reloadWorktrees: true);

    // ---- Phase 6: submodules ----

    private RenderFragment SubmodulesTab => @<div class="fx-card">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
            <span style="flex:1;" class="fx-group-head">Submodules (@_submodules.Count)</span>
            @if (_submodules.Count > 0)
            {
                <button class="fx-btn sm" @onclick="SyncSubmodulesAsync" disabled="@_busy" title="git submodule sync --recursive">Sync</button>
                <button class="fx-btn sm accent" @onclick="() => UpdateSubmodulesAsync()" disabled="@_busy" title="git submodule update --init --recursive">Update</button>
            }
        </div>
        @if (_submodules.Count == 0)
        {
            <div class="fx-hint">No submodules in this repository.</div>
        }
        @foreach (var s in _submodules)
        {
            <div class="fx-row">
                <span class="fx-code @SubmoduleClass(s.State)" title="@s.State">@SubmoduleGlyph(s.State)</span>
                <span class="grow" style="min-width:0;">
                    <span class="fx-mono">@s.Path</span>
                    <span class="fx-mono fx-faint" style="margin-left:6px;">@ShortTarget(s.Sha)</span>
                    @if (!string.IsNullOrEmpty(s.Describe)) { <span class="fx-faint" style="margin-left:6px;">@s.Describe</span> }
                </span>
