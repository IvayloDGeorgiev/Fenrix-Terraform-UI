@page "/settings"
@using Fenrix.IaCStudio.Application.Abstractions
@using Fenrix.IaCStudio.Application.Abstractions.Enterprise
@using Fenrix.IaCStudio.Application.Settings
@inject ThemeService Theme
@inject ISettingsService SettingsSvc
@inject IWorkspacePaths Paths
@inject IEnterpriseConfig Enterprise
@inject IJSRuntime JS
@implements IDisposable

<h1 class="fx-page-title">Settings</h1>
<p class="fx-page-sub">Appearance, workspace and diagnostics. More sections arrive with later phases.</p>

<div class="fx-card" style="margin-bottom:16px;">
    <h2 style="font-size:15px;margin:0 0 12px;">Appearance</h2>

    <div style="font-size:13px;color:var(--fx-dim);margin-bottom:6px;">Theme</div>
    <div style="display:flex;gap:8px;margin-bottom:16px;">
        <button class="fx-btn @Active("light")" @onclick='() => SetTheme("light")'>
            <span class="fx-ico"><Icon Name="sun" Size="15" /></span> Light
        </button>
        <button class="fx-btn @Active("dark")" @onclick='() => SetTheme("dark")'>
            <span class="fx-ico"><Icon Name="moon" Size="15" /></span> Dark
        </button>
    </div>

    <label style="display:flex;align-items:center;gap:9px;font-size:13px;cursor:pointer;">
        <input type="checkbox" checked="@_reducedMotion" @onchange="OnReducedMotionChanged" />
        Reduce motion (disable animations)
    </label>
</div>

<div class="fx-card" style="margin-bottom:16px;">
    <h2 style="font-size:15px;margin:0 0 4px;">Security</h2>
    <p style="font-size:12.5px;color:var(--fx-dim);margin:0 0 12px;">
        Files on disk are the source of truth. Deletes always go to the Recycle Bin and stay recoverable from history.
    </p>

    <label style="display:flex;align-items:flex-start;gap:9px;font-size:13px;cursor:pointer;">
        <input type="checkbox" checked="@_allowInAppDelete" @onchange="OnAllowDeleteChanged" style="margin-top:2px;" />
        <span>
            Allow in-app deletion of tracked files
            <span style="display:block;color:var(--fx-faint);font-size:12px;margin-top:2px;">
                Off by default. When off, tracked files can only be deleted from Explorer (still recoverable).
            </span>
        </span>
    </label>

    <label style="display:flex;align-items:flex-start;gap:9px;font-size:13px;cursor:pointer;margin-top:12px;">
        <input type="checkbox" checked="@_allowKeyExport" @onchange="OnAllowKeyExportChanged" style="margin-top:2px;" />
        <span>
            Allow private-key export
            <span style="display:block;color:var(--fx-faint);font-size:12px;margin-top:2px;">
                Off by default. When off, managed private keys can never be revealed or exported. Even when on,
                export still requires typing the key name and is written to the audit history.
            </span>
        </span>
    </label>
</div>

<div class="fx-card" style="margin-bottom:16px;">
    <h2 style="font-size:15px;margin:0 0 4px;">Code editor</h2>
    <p style="font-size:12.5px;color:var(--fx-dim);margin:0 0 12px;">
        The Terraform-aware editor on the Files page. Beautify runs <span class="fx-mono">terraform fmt</span>;
        Validate surfaces <span class="fx-mono">terraform validate</span> diagnostics inline.
    </p>

    <label style="display:flex;align-items:flex-start;gap:9px;font-size:13px;cursor:pointer;">
        <input type="checkbox" checked="@_formatOnSave" @onchange="OnFormatOnSaveChanged" style="margin-top:2px;" />
        <span>
            Format on save
            <span style="display:block;color:var(--fx-faint);font-size:12px;margin-top:2px;">
                Off by default. When on, the buffer is run through <span class="fx-mono">terraform fmt</span> before each save.
            </span>
        </span>
    </label>

    <label style="display:flex;align-items:center;gap:9px;font-size:13px;cursor:pointer;margin-top:12px;">
        <input type="checkbox" checked="@_wordWrap" @onchange="OnWordWrapChanged" />
        Soft-wrap long lines
    </label>

    <div style="display:flex;align-items:center;gap:9px;font-size:13px;margin-top:12px;">
        <span>Font size</span>
        <input class="fx-input" type="number" min="10" max="22" style="width:80px;" value="@_fontSize" @onchange="OnFontSizeChanged" />
        <span style="color:var(--fx-faint);">px</span>
    </div>
</div>

<div class="fx-card" style="margin-bottom:16px;">
    <h2 style="font-size:15px;margin:0 0 4px;">Enterprise</h2>
    <p style="font-size:12.5px;color:var(--fx-dim);margin:0 0 12px;">
        Organisation governance (roles, shared policy, central audit, role-gated approvals). Read-only —
        configured by <span class="fx-mono">enterprise.json</span> in the data root. See docs/29-enterprise.md.
    </p>

    @{ var status = Enterprise.Status; }
    <div style="font-size:13px;line-height:1.9;">
        <div>
            <span style="color:var(--fx-dim);">Governance:</span>
            @if (status.Enabled)
            {
                <span class="fx-pill ok">Enabled</span>
            }
            else
            {
                <span class="fx-pill">Off — single-user local mode</span>
            }
        </div>
        <div><span style="color:var(--fx-dim);">Metadata provider:</span> <span class="fx-mono">@status.MetadataProvider</span></div>
        <div><span style="color:var(--fx-dim);">Organisation:</span> @(string.IsNullOrWhiteSpace(status.Organisation) ? "—" : status.Organisation)</div>
        @if (status.Enabled)
        {
            <div>
                <span style="color:var(--fx-dim);">Connection resolved:</span>
                @(status.ConnectionResolved ? "yes" : "no — check the connection-string environment variable")
            </div>
        }
    </div>

    @if (!status.Enabled)
    {
        <p style="font-size:12px;color:var(--fx-faint);margin:12px 0 0;">
            To enable, drop an <span class="fx-mono">enterprise.json</span> in the data root and set the
            connection-string environment variable it names. The string is never written to disk.
        </p>
    }
</div>

<div class="fx-card">
    <h2 style="font-size:15px;margin:0 0 12px;">Workspace</h2>
    <div style="font-size:13px;line-height:1.9;">
        <div><span style="color:var(--fx-dim);">Data root:</span> <span class="fx-mono">@Paths.DataRoot</span></div>
        <div><span style="color:var(--fx-dim);">Database:</span> <span class="fx-mono">@Paths.DatabaseFilePath</span></div>
        <div>
            <span style="color:var(--fx-dim);">Using fallback location:</span>
            @(Paths.UsingFallback ? "yes (LOCALAPPDATA)" : "no")
        </div>
    </div>
</div>

@code {
    private bool _reducedMotion;
    private bool _allowInAppDelete;
    private bool _allowKeyExport;
    private bool _formatOnSave;
    private bool _wordWrap;
    private int _fontSize = 13;

    protected override void OnInitialized() => Theme.Changed += OnChanged;

    protected override async Task OnInitializedAsync()
    {
        _reducedMotion = await SettingsSvc.GetOrDefaultAsync(FenrixSettingKeys.ReducedMotion, false);
        _allowInAppDelete = await SettingsSvc.GetOrDefaultAsync(FenrixSettingKeys.AllowInAppDelete, false);
        _allowKeyExport = await SettingsSvc.GetOrDefaultAsync(FenrixSettingKeys.AllowPrivateKeyExport, false);
        _formatOnSave = await SettingsSvc.GetOrDefaultAsync(FenrixSettingKeys.EditorFormatOnSave, false);
        _wordWrap = await SettingsSvc.GetOrDefaultAsync(FenrixSettingKeys.EditorWordWrap, false);
        _fontSize = await SettingsSvc.GetOrDefaultAsync(FenrixSettingKeys.EditorFontSize, 13);
    }

    private string Active(string theme) => Theme.Theme == theme ? "accent" : "";

    private Task SetTheme(string theme) => Theme.SetThemeAsync(theme);

    private async Task OnReducedMotionChanged(ChangeEventArgs e)
    {
        _reducedMotion = e.Value is true;
        await SettingsSvc.SetAsync(FenrixSettingKeys.ReducedMotion, _reducedMotion.ToString());
        await JS.InvokeVoidAsync("fenrix.setReducedMotion", _reducedMotion);
    }

    private async Task OnAllowDeleteChanged(ChangeEventArgs e)
    {
        _allowInAppDelete = e.Value is true;
        await SettingsSvc.SetAsync(FenrixSettingKeys.AllowInAppDelete, _allowInAppDelete.ToString());
    }

    private async Task OnAllowKeyExportChanged(ChangeEventArgs e)
    {
        _allowKeyExport = e.Value is true;
        await SettingsSvc.SetAsync(FenrixSettingKeys.AllowPrivateKeyExport, _allowKeyExport.ToString());
    }

    private async Task OnFormatOnSaveChanged(ChangeEventArgs e)
    {
        _formatOnSave = e.Value is true;
        await SettingsSvc.SetAsync(FenrixSettingKeys.EditorFormatOnSave, _formatOnSave.ToString());
    }

    private async Task OnWordWrapChanged(ChangeEventArgs e)
    {
        _wordWrap = e.Value is true;
        await SettingsSvc.SetAsync(FenrixSettingKeys.EditorWordWrap, _wordWrap.ToString());
    }

    private async Task OnFontSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var px))
        {
            _fontSize = Math.Clamp(px, 10, 22);
            await SettingsSvc.SetAsync(FenrixSettingKeys.EditorFontSize, _fontSize.ToString());
        }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Theme.Changed -= OnChanged;
}
