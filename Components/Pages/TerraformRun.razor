@page "/projects/{ProjectId:guid}/terraform"
@using Fenrix.IaCStudio.Application.Abstractions.Projects
@using Fenrix.IaCStudio.Application.Abstractions.Terraform
@using Fenrix.IaCStudio.Application.Terraform
@using Fenrix.IaCStudio.Contracts.Terraform
@using Fenrix.IaCStudio.Domain.Common
@using Fenrix.IaCStudio.Domain.Environments
@using Fenrix.IaCStudio.Domain.Projects
@using Fenrix.IaCStudio.Domain.Terraform
@inject IProjectService Projects
@inject ITerraformExecutor Executor
@inject ITerraformDiscovery Discovery
@inject ICommandHistoryStore History
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IDisposable

@if (_project is null)
{
    <div class="fx-card" style="text-align:center;color:var(--fx-dim);">@(_loading ? "Loading…" : "Project not found.")</div>
}
else
{
    <ProjectHeader ProjectId="ProjectId" Name="@_project.Name" Active="ProjectHeader.ProjectPage.Terraform" Trail="@_workingDir">
        <Actions>
            <span class="fx-chip" title="Resolved Terraform binary">
                <span class="fx-ico"><Icon Name="hexagon" Size="13" /></span>
                @(_installation?.Version?.ToString() ?? "not found")
            </span>
            <button class="fx-btn sm" @onclick="RefreshBinaryAsync" title="Re-detect the Terraform binary">
                <span class="fx-ico"><Icon Name="refresh" Size="13" /></span> Detect
            </button>
        </Actions>
    </ProjectHeader>

    <div class="fx-split">
        <div style="display:flex;flex-direction:column;gap:16px;">
            <div class="fx-card">
                <div class="fx-field" style="margin-bottom:12px;">
                    <label>Environment</label>
                    <select class="fx-select" value="@_envId" @onchange="OnEnvChanged" disabled="@_running">
                        @foreach (var env in _environments)
                        {
                            <option value="@env.Id">@env.Name@(env.IsProduction ? " (production)" : "")</option>
                        }
                    </select>
                </div>

                <div class="fx-tabs">
                    @foreach (var kind in _kinds)
                    {
                        <button class="fx-tab @(_kind == kind ? "active" : "")" @onclick="() => SetKind(kind)" disabled="@_running">
                            @KindLabel(kind)
                        </button>
                    }
                </div>

                @switch (_kind)
                {
                    case TerraformCommandKind.Version:
                        <p class="fx-hint" style="margin:0;">Prints the version of the selected Terraform binary and its providers (<span class="fx-mono">version -json</span>).</p>
                        break;

                    case TerraformCommandKind.Init:
                        <label class="fx-check"><input type="checkbox" @bind="_initUpgrade" @bind:after="RebuildPreview" disabled="@_running" /> Upgrade modules and plugins <span class="hint">-upgrade</span></label>
                        <label class="fx-check"><input type="checkbox" @bind="_initReconfigure" @bind:after="RebuildPreview" disabled="@_running" /> Reconfigure backend <span class="hint">-reconfigure</span></label>
                        <label class="fx-check"><input type="checkbox" @bind="_initDisableBackend" @bind:after="RebuildPreview" disabled="@_running" /> Skip backend init <span class="hint">-backend=false</span></label>
                        <div class="fx-field" style="margin-top:10px;">
                            <label>Backend config file <span class="hint" style="color:var(--fx-faint);">(optional)</span></label>
                            <input class="fx-input fx-mono" placeholder="backend.hcl" @bind="_initBackendConfig" @bind:after="RebuildPreview" @bind:event="oninput" disabled="@_running" />
                        </div>
                        break;

                    case TerraformCommandKind.Format:
                        <label class="fx-check"><input type="checkbox" @bind="_fmtCheck" @bind:after="RebuildPreview" disabled="@_running" /> Check only — don't rewrite files <span class="hint">-check</span></label>
                        <label class="fx-check"><input type="checkbox" @bind="_fmtDiff" @bind:after="RebuildPreview" disabled="@_running" /> Show diff of changes <span class="hint">-diff</span></label>
                        <label class="fx-check"><input type="checkbox" @bind="_fmtRecursive" @bind:after="RebuildPreview" disabled="@_running" /> Include nested directories <span class="hint">-recursive</span></label>
                        @if (!_fmtCheck)
                        {
                            <p class="fx-hint" style="margin:8px 0 0;color:var(--fx-warn);">Write mode rewrites <span class="fx-mono">.tf</span> files in place (formatting only).</p>
                        }
                        break;

                    case TerraformCommandKind.Validate:
                        <p class="fx-hint" style="margin:0;">Validates configuration consistency and returns structured diagnostics (<span class="fx-mono">validate -json</span>). Run <strong>init</strong> first if providers aren't initialized.</p>
                        break;
                }
            </div>

            <div class="fx-card">
                <CommandPreviewPanel Preview="_preview" />

                @if (_blockReason is not null)
                {
                    <div class="fx-hint" style="margin-top:12px;color:var(--fx-warn);display:flex;gap:8px;align-items:flex-start;">
                        <span class="fx-ico" style="margin-top:1px;"><Icon Name="alert" Size="14" /></span>
                        <span>@_blockReason</span>
                    </div>
                }

                <div style="display:flex;gap:8px;margin-top:14px;">
                    @if (_running)
                    {
                        <button class="fx-btn danger" @onclick="Cancel"><span class="fx-ico"><Icon Name="stop" Size="14" /></span> Cancel</button>
                        <span class="fx-pill run"><span class="fx-ico"><Icon Name="refresh" Size="12" /></span> Running…</span>
                    }
                    else
                    {
                        <button class="fx-btn accent" @onclick="RunAsync" disabled="@(_blockReason is not null)">
                            <span class="fx-ico"><Icon Name="play" Size="13" /></span> Run
                        </button>
                    }
                    @if (_error is not null)
                    {
                        <span class="fx-pill fail" title="@_error"><span class="fx-ico"><Icon Name="alert" Size="12" /></span> @_error</span>
                    }
                </div>
            </div>
        </div>

        <div style="display:flex;flex-direction:column;gap:16px;">
            <div class="fx-card">
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;">
                    <span class="fx-ico" style="color:var(--fx-accent);"><Icon Name="terminal" Size="16" /></span>
                    <span style="flex:1;font-size:14px;font-weight:500;">Output</span>
                    @if (_lastResult is not null)
                    {
                        var (cls, text) = ResultPill(_lastResult);
                        <span class="fx-pill @cls">@text</span>
                    }
                </div>
                <OutputConsole Lines="_output" />

                @if (_validation is { ParsedFromJson: true })
                {
                    <div style="margin-top:12px;">
                        @if (_validation.Valid)
                        {
                            <span class="fx-pill ok"><span class="fx-ico"><Icon Name="check" Size="12" /></span> Configuration is valid</span>
                        }
                        else
                        {
                            <span class="fx-pill fail">@_validation.ErrorCount error(s), @_validation.WarningCount warning(s)</span>
                        }
                        @foreach (var d in _validation.Diagnostics)
                        {
                            <div class="fx-diag @(d.Severity == DiagnosticSeverity.Warning ? "warn" : "")">
                                <div class="summary">@d.Summary</div>
                                @if (!string.IsNullOrWhiteSpace(d.Detail))
                                {
                                    <div class="detail">@d.Detail</div>
                                }
                                @if (d.FileName is not null)
                                {
                                    <div class="loc">@d.FileName@(d.Line is not null ? $":{d.Line}" : "")</div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="fx-card">
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;">
                    <span class="fx-ico" style="color:var(--fx-accent);"><Icon Name="history" Size="16" /></span>
                    <span style="flex:1;font-size:14px;font-weight:500;">Recent commands</span>
                </div>
                @if (_history.Count == 0)
                {
                    <div class="fx-hint">No commands run yet.</div>
                }
                else
                {
                    @foreach (var run in _history)
                    {
                        <div class="fx-row">
                            <div class="grow" style="min-width:0;">
                                <div class="title fx-mono" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@run.DisplayCommand</div>
                                <div class="meta">@run.StartedAt.LocalDateTime.ToString("g")@(run.Duration is not null ? $" · {FormatDuration(run.Duration.Value)}" : "")</div>
                            </div>
                            <span class="fx-pill @HistoryPillClass(run.Status)">@run.Status</span>
                            <button class="fx-iconbtn" title="Copy command" @onclick="() => CopyAsync(run.DisplayCommand)"><Icon Name="copy" Size="14" /></button>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private static readonly TerraformCommandKind[] _kinds =
        [TerraformCommandKind.Version, TerraformCommandKind.Init, TerraformCommandKind.Format, TerraformCommandKind.Validate];

    private InfrastructureProject? _project;
    private List<ProjectEnvironment> _environments = [];
    private Guid _envId;
    private TerraformCommandKind _kind = TerraformCommandKind.Version;
    private TerraformInstallation? _installation;

    private CommandPreview? _preview;
    private string? _blockReason;
    private string _workingDir = "";

    private readonly List<ProcessOutputEvent> _output = [];
    private bool _running;
    private bool _loading = true;
    private string? _error;
    private CancellationTokenSource? _cts;
    private TerraformRunResult? _lastResult;
    private TerraformValidationResult? _validation;
    private List<CommandRunSummary> _history = [];
    private Guid _loadedId;

    // Init options
    private bool _initUpgrade, _initReconfigure, _initDisableBackend;
    private string _initBackendConfig = "";
    // Format options
    private bool _fmtCheck = true, _fmtDiff = true, _fmtRecursive = true;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == ProjectId) return;
        _loadedId = ProjectId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _project = await Projects.GetAsync(ProjectId);
        _loading = false;
        if (_project is null) return;

        _environments = _project.Environments.OrderBy(e => e.DisplayOrder).ThenBy(e => e.Name).ToList();
        _envId = _environments.FirstOrDefault()?.Id ?? Guid.Empty;
        PrefillEnvOptions();

        _installation = await Discovery.ResolveAsync(ProjectId);
        RebuildPreview();
        await LoadHistoryAsync();
    }

    private void OnEnvChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
            _envId = id;
        PrefillEnvOptions();
        RebuildPreview();
    }

    private void PrefillEnvOptions()
    {
        var env = SelectedEnvironment;
        if (env is not null && !string.IsNullOrWhiteSpace(env.BackendConfigFile) && string.IsNullOrWhiteSpace(_initBackendConfig))
            _initBackendConfig = env.BackendConfigFile;
    }

    private void SetKind(TerraformCommandKind kind)
    {
        _kind = kind;
        RebuildPreview();
    }

    private ProjectEnvironment? SelectedEnvironment => _environments.FirstOrDefault(e => e.Id == _envId);

    private TerraformRunSpec BuildSpec() => new(ProjectId, _envId, _kind)
    {
        Init = new InitOptions
        {
            Upgrade = _initUpgrade,
            Reconfigure = _initReconfigure,
            DisableBackend = _initDisableBackend,
            BackendConfigFile = string.IsNullOrWhiteSpace(_initBackendConfig) ? null : _initBackendConfig.Trim()
        },
        Format = new FormatOptions { CheckOnly = _fmtCheck, ShowDiff = _fmtDiff, Recursive = _fmtRecursive },
        Validate = new ValidateOptions { Json = true }
    };

    // Builds the live preview locally (no process spawn) using the cached installation.
    private void RebuildPreview()
    {
        _error = null;
        _workingDir = ResolveWorkingDir();
        var spec = BuildSpec();
        var exePath = _installation?.ExecutablePath ?? "terraform";
        var request = CommandPreviewBuilder.BuildRequest(spec, exePath, _workingDir);
        _preview = CommandPreviewBuilder.BuildPreview(request, BuildChips(request.RiskLevel));
        _blockReason = LocalBlockReason();
    }

    private string ResolveWorkingDir()
    {
        if (_project is null) return "";
        var wd = SelectedEnvironment?.WorkingDirectory;
        if (string.IsNullOrWhiteSpace(wd)) return _project.RootPath;
        return Path.IsPathRooted(wd) ? wd : Path.Combine(_project.RootPath, wd);
    }

    private IEnumerable<CommandContextChip> BuildChips(TerraformRiskLevel risk)
    {
        var chips = new List<CommandContextChip>
        {
            new("Terraform", _installation?.Version?.ToString() ?? "not found")
        };
        if (!string.IsNullOrWhiteSpace(_project?.RequiredTerraformVersion))
            chips.Add(new CommandContextChip("Requires", _project!.RequiredTerraformVersion!));
        chips.Add(new CommandContextChip("Risk", RiskLabel(risk)));
        return chips;
    }

    private string? LocalBlockReason()
    {
        if (SelectedEnvironment is null) return "Select an environment to run against.";
        if (string.IsNullOrWhiteSpace(_workingDir) || !Directory.Exists(_workingDir))
            return $"Working directory not found: {_workingDir}";
        if (_installation is null) return "No Terraform binary found. Set the executable in Settings or install Terraform on your PATH.";
        if (_installation.Version is null) return $"Could not read the version of the Terraform binary at {_installation.ExecutablePath}.";
        if (!_installation.SatisfiesConstraint(_project?.RequiredTerraformVersion))
            return $"Terraform {_installation.Version} does not satisfy this project's required version '{_project?.RequiredTerraformVersion}'.";
        return null;
    }

    private async Task RefreshBinaryAsync()
    {
        _installation = await Discovery.ResolveAsync(ProjectId);
        RebuildPreview();
    }

    private async Task RunAsync()
    {
        if (_blockReason is not null) return;

        _running = true;
        _error = null;
        _output.Clear();
        _lastResult = null;
        _validation = null;
        _cts = new CancellationTokenSource();

        try
        {
            var plan = await Executor.PlanAsync(BuildSpec(), _cts.Token);
            if (!plan.CanRun)
            {
                _blockReason = plan.BlockReason;
                _error = plan.BlockReason;
                return;
            }

            var progress = new Progress<ProcessOutputEvent>(OnLine);
            _lastResult = await Executor.ExecuteAsync(plan, progress, _cts.Token);
            _validation = _lastResult.Validation;
        }
        catch (OperationCanceledException)
        {
            // Cancellation is surfaced through the run result / pill; nothing extra to show.
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _running = false;
            _cts?.Dispose();
            _cts = null;
            await LoadHistoryAsync();
            StateHasChanged();
        }
    }

    private void OnLine(ProcessOutputEvent e)
    {
        _output.Add(e);
        StateHasChanged();
    }

    private void Cancel() => _cts?.Cancel();

    private async Task LoadHistoryAsync()
        => _history = (await History.GetRecentAsync(ProjectId, 25)).ToList();

    private void GoToFiles() => Nav.NavigateTo($"/projects/{ProjectId}");

    private void GoToPlan() => Nav.NavigateTo($"/projects/{ProjectId}/plan");

    private async Task CopyAsync(string text)
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", text); }
        catch { /* clipboard unavailable */ }
    }

    private static (string Cls, string Text) ResultPill(TerraformRunResult r) => r.Process.Cancelled
        ? ("warn", "Cancelled")
        : r.Process.Succeeded
            ? ("ok", $"Succeeded · {FormatDuration(r.Process.Duration)}")
            : ("fail", $"Exit {r.Process.ExitCode} · {FormatDuration(r.Process.Duration)}");

    private static string HistoryPillClass(string status) => status switch
    {
        "Succeeded" => "ok",
        "Failed" => "fail",
        "Cancelled" => "warn",
        "Running" => "run",
        _ => "muted"
    };

    private static string KindLabel(TerraformCommandKind kind) => kind switch
    {
        TerraformCommandKind.Version => "Version",
        TerraformCommandKind.Init => "Init",
        TerraformCommandKind.Format => "Format",
        TerraformCommandKind.Validate => "Validate",
        _ => kind.ToString()
    };

    private static string RiskLabel(TerraformRiskLevel risk) => risk switch
    {
        TerraformRiskLevel.ReadOnly => "read-only",
        TerraformRiskLevel.Safe => "safe",
        TerraformRiskLevel.StateChanging => "state-changing",
        TerraformRiskLevel.Destructive => "destructive",
        _ => risk.ToString()
    };

    private static string FormatDuration(TimeSpan d) =>
        d.TotalSeconds < 1 ? $"{d.TotalMilliseconds:0} ms" : $"{d.TotalSeconds:0.0} s";

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
