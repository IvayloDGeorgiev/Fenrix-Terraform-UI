@page "/connections"

<h1 class="fx-page-title">Connections</h1>
<p class="fx-page-sub">Your global library of cloud and repository connections. Bound per environment; secrets are never stored here.</p>

<div class="fx-card" style="text-align:center;padding:40px;">
    <div style="color:var(--fx-accent);margin-bottom:10px;"><Icon Name="plug" Size="28" /></div>
    <h2 style="font-size:16px;margin:0 0 6px;">No connections yet</h2>
    <p style="color:var(--fx-dim);font-size:13px;margin:0 0 16px;">
        Add a cloud account or a Git host once, then bind it to any environment.
    </p>
    <button class="fx-btn accent"><span class="fx-ico"><Icon Name="plug" Size="14" /></span> New connection</button>
</div>
