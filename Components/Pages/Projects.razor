@page "/projects"
@using Fenrix.IaCStudio.Application.Abstractions.Projects
@using Fenrix.IaCStudio.Contracts.Projects
@using Microsoft.AspNetCore.Components.Web.Virtualization
@inject IProjectService ProjectSvc
@inject NavigationManager Nav

<div style="display:flex;align-items:flex-start;gap:12px;margin-bottom:16px;">
    <div style="flex:1;">
        <h1 class="fx-page-title">Projects</h1>
        <p class="fx-page-sub" style="margin:0;">Your registered Terraform projects. Files on disk stay the source of truth.</p>
    </div>
    <button class="fx-btn" @onclick="RescanAsync" disabled="@_rescanning"
            title="Re-scan the projects folder for projects added or removed on disk">
        <span class="fx-ico"><Icon Name="refresh" Size="14" /></span> @(_rescanning ? "Rescanning…" : "Rescan")
    </button>
    <button class="fx-btn" @onclick="() => _showImport = true">
        <span class="fx-ico"><Icon Name="upload" Size="14" /></span> Add existing
    </button>
    <button class="fx-btn accent" @onclick="() => _showNew = true">
        <span class="fx-ico"><Icon Name="folder-plus" Size="14" /></span> New project
    </button>
</div>

@if (_rescanStatus is not null)
{
    <div class="fx-hint" style="margin:-8px 0 14px;color:var(--fx-accent-text);">@_rescanStatus</div>
}

@if (_loading)
{
    <div class="fx-card" style="text-align:center;color:var(--fx-dim);">Loading…</div>
}
else if (_all.Count == 0)
{
    <div class="fx-card" style="text-align:center;padding:40px;">
        <div style="color:var(--fx-accent);margin-bottom:10px;"><Icon Name="folder" Size="28" /></div>
        <h2 style="font-size:16px;margin:0 0 6px;">No projects yet</h2>
        <p style="color:var(--fx-dim);font-size:13px;margin:0 0 16px;">
            Create a new project or import an existing Terraform repository to get started.
        </p>
        <div style="display:flex;gap:8px;justify-content:center;">
            <button class="fx-btn" @onclick="() => _showImport = true">Add existing</button>
            <button class="fx-btn accent" @onclick="() => _showNew = true">New project</button>
        </div>
    </div>
}
else
{
    <div class="fx-filterbar">
        <div class="fx-picker-search" style="flex:1;min-width:200px;">
            <span class="fx-ico"><Icon Name="search" Size="15" /></span>
            <input class="fx-input" placeholder="Search by name or path…" @bind="_query" @bind:after="StateHasChanged" @bind:event="oninput" />
            @if (!string.IsNullOrEmpty(_query))
            {
                <button class="fx-iconbtn" title="Clear" @onclick="@(() => { _query = string.Empty; })"><Icon Name="x" Size="14" /></button>
            }
        </div>

        <select class="fx-select" style="width:auto;" @bind="_location">
            <option value="@Location.All">All locations</option>
            <option value="@Location.Workspace">In workspace</option>
            <option value="@Location.Linked">Linked</option>
        </select>

        <select class="fx-select" style="width:auto;" @bind="_sort">
            <option value="@Sort.Recent">Recently opened</option>
            <option value="@Sort.Name">Name (A–Z)</option>
            <option value="@Sort.Created">Newest</option>
        </select>
    </div>

    @if (IsDefaultView && _recent.Count > 0)
    {
        <div class="fx-section-head">Recent</div>
        <div class="fx-proj-grid">
            @foreach (var p in _recent)
            {
                <ProjectCard Project="p" OnClick="() => Open(p.Id)" />
            }
        </div>
        <div class="fx-section-head" style="margin-top:18px;">All projects <span class="fx-faint">(@Filtered.Count)</span></div>
    }
    else
    {
        <div class="fx-section-head">@Filtered.Count result@(Filtered.Count == 1 ? "" : "s")</div>
    }

    @if (Filtered.Count == 0)
    {
        <div class="fx-card fx-hint" style="text-align:center;padding:28px;">No projects match your search and filters.</div>
    }
    else
    {
        <div class="fx-proj-scroll">
            <Virtualize Items="Rows" Context="row" ItemSize="106">
                <div class="fx-proj-grid-row" style="grid-template-columns:repeat(@Columns,minmax(0,1fr));">
                    @foreach (var p in row)
                    {
                        <ProjectCard Project="p" OnClick="() => Open(p.Id)" />
                    }
                </div>
            </Virtualize>
        </div>
    }
}

@if (_showNew)
{
    <NewProjectDialog OnClose="() => _showNew = false" OnCreated="OnProjectAddedAsync" />
}
@if (_showImport)
{
    <ImportProjectDialog OnClose="() => _showImport = false" OnImported="OnProjectAddedAsync" />
}

@code {
    private enum Location { All, Workspace, Linked }
    private enum Sort { Recent, Name, Created }

    private const int Columns = 3;

    private List<ProjectSummary> _all = [];
    private List<ProjectSummary> _recent = [];
    private bool _loading = true;
    private bool _showNew;
    private bool _showImport;
    private bool _rescanning;
    private string? _rescanStatus;

    private string _query = "";
    private Location _location = Location.All;
    private Sort _sort = Sort.Recent;

    private bool IsDefaultView =>
        string.IsNullOrWhiteSpace(_query) && _location == Location.All && _sort == Sort.Recent;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _all = (await ProjectSvc.ListAsync()).ToList();
        _recent = (await ProjectSvc.GetRecentAsync(Columns)).ToList();
        _loading = false;
    }

    private List<ProjectSummary> Filtered
    {
        get
        {
            IEnumerable<ProjectSummary> items = _all;

            items = _location switch
            {
                Location.Workspace => items.Where(p => !p.IsLinked),
                Location.Linked => items.Where(p => p.IsLinked),
                _ => items
            };

            var q = _query.Trim();
            if (q.Length > 0)
                items = items.Where(p =>
                    p.Name.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    p.RootPath.Contains(q, StringComparison.OrdinalIgnoreCase));

            items = _sort switch
            {
                Sort.Name => items.OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase),
                Sort.Created => items.OrderByDescending(p => p.CreatedAt),
                _ => items.OrderByDescending(p => p.LastOpenedAt ?? p.CreatedAt)
            };

            return items.ToList();
        }
    }

    // Chunk into fixed-width rows so the card grid can be virtualized (scales to thousands of projects).
    private List<ProjectSummary[]> Rows => Filtered.Chunk(Columns).ToList();

    private async Task OnProjectAddedAsync(Guid projectId)
    {
        _showNew = false;
        _showImport = false;
        Nav.NavigateTo($"/projects/{projectId}");
    }

    private void Open(Guid projectId) => Nav.NavigateTo($"/projects/{projectId}");

    // Re-scan the projects folder so manually added/removed projects show up without a restart.
    private async Task RescanAsync()
    {
        _rescanning = true;
        _rescanStatus = null;
        StateHasChanged();
        try
        {
            var r = await ProjectSvc.RescanAsync();
            await LoadAsync();
            _rescanStatus = r.Added == 0 && r.Removed == 0
                ? "Rescan complete — no changes found."
                : $"Rescan complete — added {r.Added}, removed {r.Removed}.";
        }
        catch (Exception ex)
        {
            _rescanStatus = $"Rescan failed: {ex.Message}";
        }
        finally
        {
            _rescanning = false;
            StateHasChanged();
        }
    }
}
