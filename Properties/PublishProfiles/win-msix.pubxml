<?xml version="1.0" encoding="utf-8"?>
<!--
  Fenrix IaC Studio — Windows MSIX release profile (Phase 12).
  See docs/18-packaging-deployment.md and docs/31-release-prep.md.

  Publish from Visual Studio (right-click the project → Publish → this profile), or from the CLI:

    dotnet publish -f net10.0-windows10.0.19041.0 -c Release `
      -p:PublishProfile=win-msix `
      -p:RuntimeIdentifierOverride=win10-x64

  Signing is intentionally NOT specified here so unsigned local test packages can be produced. For a
  distributable, signed package set PackageCertificateThumbprint (a cert installed in the machine store) or
  sign the produced .msix with signtool afterwards — see docs/31. The Publisher in Package.appxmanifest must
  match the signing certificate's subject.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win10-x64</RuntimeIdentifier>

    <!-- Produce a packaged MSIX rather than the unpackaged dev build. -->
    <WindowsPackageType>MSIX</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>

    <!-- App-store / sideload bundle. Generates an .msixupload / .msix under bin\Release\...\AppPackages. -->
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Always</AppxBundle>
    <AppxBundlePlatforms>x64</AppxBundlePlatforms>
    <AppxAutoIncrementPackageRevision>false</AppxAutoIncrementPackageRevision>

    <!-- Ship trimmed + R2R for a smaller, faster-starting release (verify no reflection breakage first). -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
</Project>
